Solvers"},{name:"Stegall",slug:"stegall",description:"Drop any file and Stegall runs every applicable steg technique in parallel: LSB sweeps, bit planes, spectrograms, polyglot carving, metadata, whitespace decode, and a 6-layer base/ROT/XOR/zlib cascade. Recursively unpacks results and surfaces flag matches.",category:"Solvers"},{name:"Pwntools Forge",slug:"pwntools-forge",description:"Generate a complete pwntools exploit script from a template: ret2win, shellcode, ret2libc, ROP chain, format string, or blank scaffold. Fill the form, copy or download the .py file. Fully editable before saving.",category:"Solvers"},{name:"Base64 & Base32 Decoder",slug:"base64-decoder",description:"Decode Base64 and Base32 strings with auto-detection. Multi-layer mode unwraps nested encodings automatically.",category:"Encoding & Bases"},{name:"Number Base Converter",slug:"number-base-converter",description:"Convert numbers between binary, octal, decimal, and hexadecimal instantly. Enter any value and see all four bases update in real time.",category:"Encoding & Bases"},{name:"Binary to Hex Converter",slug:"binary-to-hex",description:"Normalize binary strings and convert them instantly to hexadecimal, decimal, and octal.",category:"Encoding & Bases"},{name:"URL Encoder / Decoder",slug:"url-encoder",description:"Encode and decode URL-encoded (percent-encoded) strings. Useful for web exploitation challenges involving query parameters, form data, and HTTP headers.",category:"Encoding & Bases"},{name:"Morse Code Decoder",slug:"morse-decoder",description:"Decode Morse code to plain text or encode text to Morse code. Supports all letters, digits, and common punctuation.",category:"Encoding & Bases"},{name:"ROT / Caesar Cipher",slug:"rot-cipher",description:"Decode Caesar-shifted and ROT-encoded text. Drag the shift slider or scan all 26 rotations at once.",category:"Classical Ciphers"},{name:"Vigenère Cipher",slug:"vigenere-cipher",description:"Encrypt or decrypt text with the Vigenère polyalphabetic substitution cipher using a keyword.",category:"Classical Ciphers"},{name:"Affine Cipher",slug:"affine-cipher",description:"Encrypt, decrypt, or brute-force affine ciphers using E(x) = (ax + b) mod 26. Brute force ranks all 312 key pairs by English letter frequency.",category:"Classical Ciphers"},{name:"Frequency Analysis",slug:"frequency-analysis",description:"Analyze letter frequencies in a substitution cipher and interactively build the decryption mapping with auto-filled guesses.",category:"Classical Ciphers"},{name:"XOR Cipher",slug:"xor-cipher",description:"XOR-decrypt hex or text ciphertext with a known key, or brute-force the single-byte key automatically.",category:"Modern Crypto"},{name:"RSA Calculator",slug:"rsa-calculator",description:"Decrypt RSA ciphertexts, factor n from the sum of primes, or generate key parameters. Handles arbitrarily large BigInt values.",category:"Modern Crypto"},{name:"Hash Identifier",slug:"hash-identifier",description:"Identify unknown hash types by length and prefix. Covers MD5, SHA-1, SHA-256, SHA-512, bcrypt, NTLM, and more.",category:"Modern Crypto"},{name:"Checksum Calculator",slug:"checksum-calculator",description:"Compute CRC32, MD5, SHA-1, SHA-256, SHA-384, and SHA-512 hashes for text or uploaded files. Verify against known hashes.",category:"Modern Crypto",updatedAt:"2026-07-18"},{name:"File Magic Identifier",slug:"file-magic-identifier",description:"Identify file types from magic numbers. Paste hex bytes or drop a file to detect PNG, JPEG, ZIP, PDF, ELF, PCAP, SQLite, and dozens of other formats.",category:"Forensics"},{name:"Image Metadata Viewer",slug:"metadata-viewer",description:"Read EXIF, XMP, JPEG comments, and PNG tEXt / iTXt / zTXt chunks from images entirely in the browser. Highlights flag-like values.",category:"Forensics"},{name:"Strings Extractor",slug:"strings-extractor",description:"Pull printable text from any binary, library, or image. ASCII and UTF-16 detection, configurable minimum length, flag-like highlight, no command line needed.",category:"Forensics"},{name:"QR Code & Barcode Decoder",slug:"qr-decoder",description:"Decode QR codes, Data Matrix, Aztec, PDF417, and 1D barcodes from any uploaded image. Browser-native, no upload to a server.",category:"Forensics"},{name:"Password Steg (Encrypt & Decrypt)",slug:"password-steg",description:"Password-protect a message with AES-GCM and PBKDF2-derived keys. Encode produces a base64 ciphertext you can hide in any carrier; decode recovers the original with the same password. Runs entirely in the browser.",category:"Forensics"},{name:"Cipher Identifier & Auto-Decoder",slug:"cipher-identifier",description:"Paste any ciphertext and the tool auto-runs every common decoder (base64, hex, Morse, ROT, Atbash, Bacon, binary, decimal, URL) and ranks the results by English-likeness.",category:"Classical Ciphers"},{name:"Atbash Cipher",slug:"atbash-cipher",description:"Encode or decode the Atbash mirror cipher (A↔Z) in one click. Self-inverse, no key required.",category:"Classical Ciphers"},{name:"Rail Fence Cipher",slug:"railfence-cipher",description:"Encrypt or decrypt rail fence (zigzag) transposition ciphers. Brute-force across rail counts and offsets to find the right setting fast.",category:"Classical Ciphers"},{name:"Bacon Cipher",slug:"bacon-cipher",description:"Decode Baconian A/B ciphers, including hidden-bit case and vowel encodings where each letter carries one bit.",category:"Classical Ciphers"},{name:"AES Decryptor",slug:"aes-decryptor",description:"Decrypt AES-CBC, AES-GCM, AES-CTR, and AES-ECB ciphertexts with a known key and IV. Hex / base64 / UTF-8 inputs, AES-128/192/256, PKCS#7 padding.",category:"Modern Crypto"},{name:"Binary Calculator",slug:"binary-calculator",description:"Perform binary arithmetic (add, subtract, multiply, divide) with copyable outputs in every base.",category:"Binary & Data"},{name:"Bit Shift Calculator",slug:"bit-shift-calculator",description:"Perform left/right bit shifts and see the result across binary, octal, decimal, and hex.",category:"Binary & Data"},{name:"Endianness Converter",slug:"endianness-converter",description:"Convert between big-endian and little-endian byte order with visual byte layout. Supports 16-bit, 32-bit, and 64-bit words.",category:"Binary & Data"},{name:"Hex Viewer",slug:"hex-viewer",description:"View text or raw hex bytes as a xxd-style hex dump with byte offset, hex columns, and ASCII sidebar. Highlights printable characters and null bytes.",category:"Binary & Data"},{name:"Binary Search",slug:"binary-search-tree",description:"Visualize the halving strategy used in picoCTF's Binary Search challenge.",category:"Binary & Data"},{name:"SQL Injection Payload Generator",slug:"sql-injection",description:"Generate SQL injection payloads for auth bypass, UNION extraction, blind SQLi, NoSQL operator injection, and sqlmap commands. Supports MySQL, PostgreSQL, SQLite, and MSSQL.",category:"Web",updatedAt:"2026-06-12"},{name:"Regex Tester",slug:"regex-tester",description:"Test regular expressions against a string with live match highlighting, flag toggles, and common CTF pattern shortcuts.",category:"Web"},{name:"JWT Decoder",slug:"jwt-decoder",description:"Decode JSON Web Tokens and inspect the header, payload, and signature. Useful for web exploitation challenges.",category:"Web"},{name:"Timestamp Converter",slug:"timestamp-converter",description:"Convert Unix timestamps (seconds or milliseconds), hex timestamps, and date strings to every common format.",category:"Web"},{name:"Flask Session Decoder",slug:"flask-session-decoder",description:"Decode Flask / itsdangerous session cookies. Splits payload, decompresses zlib, parses JSON, and verifies the HMAC signature when given the secret.",category:"Web"},{name:"Reverse Shell Generator",slug:"reverse-shell-generator",description:"Generate reverse shell payloads (bash, nc, python, perl, ruby, php, node, powershell) and matching listeners. Set host and port once, copy any variant.",category:"Web"},{name:"Cyclic Pattern Generator",slug:"cyclic-pattern",description:"Generate de Bruijn cyclic patterns and find buffer overflow offsets. The browser equivalent of pwntools cyclic and cyclic_find.",category:"Binary Exploitation"},{name:"pwntools Payload Builder",slug:"pwntools-payload",description:"Pack integers into little-endian bytes (p32 / p64), unpack bytes back to integers, and build flat ROP payloads with offset-based insertion.",category:"Binary Exploitation"},{name:"ASCII Table",slug:"ascii-table",description:"Interactive ASCII reference with quick lookup by character, decimal, hex, or binary. Filter by printable, control, letters, digits, or symbols.",category:"Reference"}];n.map(e=>[e.slug,e]),["Solvers","Encoding & Bases","Classical Ciphers","Modern Crypto","Forensics","Binary & Data","Binary Exploitation","Web","Reference"].map(e=>[e,n.filter(r=>r.category===e)]);let s=new Map;for(let[e,r]of Object.entries({"recipe-chain":["base64-decoder","cipher-identifier","xor-cipher","rot-cipher"],stegall:["password-steg","metadata-viewer","file-magic-identifier","strings-extractor"],"pwntools-forge":["pwntools-payload","cyclic-pattern","hex-viewer","reverse-shell-generator"],"base64-decoder":["recipe-chain","url-encoder","hex-viewer","binary-to-hex"],"number-base-converter":["binary-to-hex","ascii-table","bit-shift-calculator","endianness-converter"],"binary-to-hex":["number-base-converter","ascii-table","hex-viewer","endianness-converter"],"url-encoder":["base64-decoder","sql-injection","jwt-decoder","regex-tester"],"morse-decoder":["cipher-identifier","bacon-cipher","recipe-chain","frequency-analysis"],"rot-cipher":["atbash-cipher","vigenere-cipher","cipher-identifier","frequency-analysis"],"vigenere-cipher":["frequency-analysis","cipher-identifier","rot-cipher","xor-cipher"],"affine-cipher":["rot-cipher","atbash-cipher","frequency-analysis","cipher-identifier"],"frequency-analysis":["cipher-identifier","vigenere-cipher","rot-cipher","a