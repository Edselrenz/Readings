(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,75157,(e,t,i)=>{t.exports=JSON.parse('[{"challenge_name":"Secure Password Database","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"Reverse engineer a binary to uncover how it stores and validates a password, then recover the hidden flag.","id":767,"techniques":["strings","binary-analysis","xor"]},{"challenge_name":"Undo","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"A flag has been scrambled by a series of Linux text transformations. Undo the operations to restore it.","id":766,"techniques":["linux-cli","bash"]},{"challenge_name":"No FA","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A web login protected by two-factor authentication. Find a way past it to access the flag.","id":765,"techniques":["authentication-bypass","flask-session","hash-cracking"]},{"challenge_name":"MY GIT","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"Git takes the commit author from client config, so set your name and email to root, push flag.txt, and the flag lands.","id":764,"techniques":["git"]},{"challenge_name":"Heap Havoc","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2026","solved":true,"blurb":"An unbounded strcpy overruns a heap buffer into the next chunk, overwriting an exit-time callback pointer.","id":763,"tools":["pwntools-payload"],"techniques":["buffer-overflow"]},{"challenge_name":"bytemancy 1","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"A server asks you to send a specific sequence of bytes. Decode what it wants and respond correctly.","id":762,"techniques":["encoding"]},{"challenge_name":"Bypass Me","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"Analyze a password-protected binary, understand its authentication logic, and find a way in.","id":761,"tools":["strings-extractor"],"techniques":["binary-analysis","decompilation","debugging"]},{"challenge_name":"Smart_Overflow","difficulty":"medium","category":"Blockchain","event":"picoCTF 2026","solved":true,"blurb":"The contract\'s uint256 deposit arithmetic wraps, so seed a balance then deposit 2^256 minus 1 to unlock the flag.","id":760,"techniques":["integer-overflow","blockchain"]},{"challenge_name":"Printer Shares","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"A file was sent to a network printer by mistake. Access the print server to retrieve it.","id":759,"techniques":["smb","network-forensics"]},{"challenge_name":"Pizza Router","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A binary exploitation challenge involving unsafe memory access in a routing program.","id":758,"techniques":["heap-exploitation","out-of-bounds"]},{"challenge_name":"ping-cmd","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"A service accepts user input without sanitizing it before running a system command. Exploit this flaw.","id":757,"techniques":["command-injection"]},{"challenge_name":"Failure Failure","difficulty":"medium","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"A load-balanced web service behaves differently depending on how requests are routed. Find the right path.","id":756,"techniques":["denial-of-service","http-automation"]},{"challenge_name":"Echo Escape 1","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A binary exploitation challenge targeting a vulnerable echo service to gain control of execution flow.","id":755,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow","ret2win"]},{"challenge_name":"Autorev 1","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"The server streams twenty binaries a second apart, so only an automated decompile-and-extract solver keeps up.","id":754,"techniques":["decompilation","binary-analysis"]},{"challenge_name":"Reentrance","difficulty":"hard","category":"Blockchain","event":"picoCTF 2026","solved":true,"blurb":"The vault sends ETH before updating its balance, so an attacker contract re-entering from its fallback drains it.","id":753,"techniques":["reentrancy","blockchain"]},{"challenge_name":"ORDER ORDER","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A web app with a SQL injection vulnerability hidden in the user registration or reporting flow.","id":752,"techniques":["sql-injection"]},{"challenge_name":"Hidden Cipher 2","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"Reverse engineer a binary that applies a custom per-character transformation to the flag.","id":751,"tools":["cipher-identifier"],"techniques":["custom-cipher","classical-cipher"]},{"challenge_name":"Hashgate","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A web app uses predictable identifiers for user profiles. Find the admin account to read the flag.","id":750,"techniques":["idor","brute-force"]},{"challenge_name":"Credential Stuffing","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"Try a set of leaked credentials against a login service to find the one that grants access to the flag.","id":749,"techniques":["credential-stuffing","authentication-bypass"]},{"challenge_name":"ABSOLUTE NANO","difficulty":"medium","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"You land in a restricted shell with limited commands available. Find a way to break out and read the flag.","id":748,"techniques":["sudo-privilege-escalation","linux-cli"]},{"challenge_name":"Secret Box","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A web app stores user input that gets used in a database query later. Craft a username that extracts the flag.","id":747,"techniques":["sql-injection"]},{"challenge_name":"tea-cash","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2026","solved":true,"blurb":"Walk the tcache free list by adding 0x90 to each chunk address until you reach the one still holding the flag.","id":746,"techniques":["tcache","heap-exploitation"]},{"challenge_name":"Hidden Cipher 1","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"A binary hides the flag behind a simple cipher. Identify the encryption scheme and recover the plaintext.","id":745,"tools":["cipher-identifier"],"techniques":["custom-cipher","classical-cipher"]},{"challenge_name":"Front_Running","difficulty":"hard","category":"Blockchain","event":"picoCTF 2026","solved":true,"blurb":"Watch the mempool for the victim\'s pre-image, then resubmit that answer with a higher gas price to mine first.","id":744,"techniques":["blockchain"]},{"challenge_name":"Fool the Lockout","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A login page enforces rate limiting. Find a way to work around it and brute-force your way in.","id":743,"techniques":["authentication-bypass","credential-stuffing"]},{"challenge_name":"bytemancy 0","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"A general skills challenge testing your understanding of ASCII encoding and how programs parse character input.","id":742,"techniques":["encoding"]},{"challenge_name":"Printer Shares 3","difficulty":"hard","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"Explore an exposed network file share and find a way to escalate access to retrieve a protected flag.","id":741,"techniques":["smb","network-forensics"]},{"challenge_name":"Piece by Piece","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"SSH into a remote machine, locate fragmented archive files, and reassemble them to uncover the flag.","id":740,"techniques":["linux-cli","zip-forensics"]},{"challenge_name":"Old Sessions","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"Sessions never expire, so an old admin session listed on /sessions can be adopted as your own cookie.","id":739,"tools":["flask-session-decoder"],"techniques":["cookie-manipulation","authentication-bypass"]},{"challenge_name":"offset-cycleV2","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2026","solved":true,"blurb":"NX is disabled, so find the overflow offset, pivot through a jmp rsp gadget, and land in stack shellcode against a timer.","id":738,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow","shellcode"]},{"challenge_name":"JITFP","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"The checker resolves each password character through a function pointer, so read those under a debugger and unshuffle.","id":737,"techniques":["debugging","gdb"]},{"challenge_name":"Echo Escape 2","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A binary exploitation challenge involving a subtle memory handling flaw that leaks protected data.","id":736,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow","ret2win"]},{"challenge_name":"SUDO MAKE ME A SANDWICH","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"Use elevated system permissions on a Linux machine to access a flag restricted to privileged users.","id":735,"techniques":["linux-cli","sudo-privilege-escalation"]},{"challenge_name":"Printer Shares 2","difficulty":"hard","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"Investigate an exposed network share and chain together clues to authenticate as a valid user and retrieve the flag.","id":734,"techniques":["smb","network-forensics"]},{"challenge_name":"offset-cycle","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2026","solved":true,"blurb":"Find the overflow offset with a cyclic pattern, then overwrite the saved return address with the address of win().","id":733,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow","rop"]},{"challenge_name":"KSECRETS","difficulty":"medium","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"Interact with a Kubernetes cluster environment to locate and decode a secret stored within it.","id":732,"techniques":["linux-cli","kubernetes"]},{"challenge_name":"Gatekeeper","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"Reverse engineer a binary to determine the exact input property it requires before granting access to the flag.","id":731,"techniques":["decompilation","encoding"]},{"challenge_name":"bytemancy 3","difficulty":"medium","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"Read the four function addresses from the non-PIE binary and send them back as raw little-endian bytes in order.","id":730,"techniques":["encoding"]},{"challenge_name":"Sql Map1","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A web challenge combining SQL injection and weak credential storage to gain unauthorized access.","id":729,"tools":["sql-injection"],"techniques":["sql-injection"]},{"challenge_name":"Secure Dot Product","difficulty":"hard","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"The oracle uses a raw SHA-512 MAC, so length extension forges vectors and 32 of them solve as a system over Z/256.","id":728,"techniques":["length-extension-attack","modular-arithmetic"]},{"challenge_name":"Quizploit","difficulty":"easy","category":"Binary Exploitation","event":"picoCTF 2026","solved":true,"blurb":"Answer questions about a provided binary\'s source code and structure to demonstrate your static analysis skills.","id":727,"techniques":["binary-analysis","source-inspection"]},{"challenge_name":"paper-2","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"A hard web exploitation challenge chaining multiple advanced vulnerabilities to exfiltrate a secret from a hardened app.","id":726,"techniques":["xslt-injection","side-channel"]},{"challenge_name":"North-South","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2026","solved":true,"blurb":"Only one region routes to the server holding the flag, so read the config and request the URL through a VPN there.","id":725,"techniques":["network-bypass"]},{"challenge_name":"bytemancy 2","difficulty":"medium","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"The server compares your input against raw byte values, so send those bytes rather than their printable spellings.","id":724,"techniques":["encoding"]},{"challenge_name":"Access_Control","difficulty":"medium","category":"Blockchain","event":"picoCTF 2026","solved":true,"blurb":"The contract exposes an unguarded owner setter, so claim ownership and call the owner-only routine that returns the flag.","id":723,"techniques":["blockchain"]},{"challenge_name":"Timestamped Secrets","difficulty":"medium","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"A cryptography challenge exploiting a predictable key generation scheme to recover an encrypted message.","id":722,"techniques":["aes","brute-force"]},{"challenge_name":"StegoRSA","difficulty":"easy","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"Retrieve an RSA private key carelessly hidden in image file metadata, then use it to decrypt the flag.","id":719,"techniques":["steganography","metadata-analysis","rsa"]},{"challenge_name":"Small Trouble","difficulty":"medium","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"A cryptography challenge targeting RSA when a weak parameter choice makes the encryption mathematically reversible.","id":718,"techniques":["rsa","wiener-attack"]},{"challenge_name":"Silent Stream","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"Analyze a packet capture containing a file transferred with a custom encoding scheme and reconstruct the original.","id":717,"techniques":["pcap-analysis","encoding"]},{"challenge_name":"shift registers","difficulty":"medium","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"Analyze a stream cipher built on a linear feedback shift register and recover the flag by reconstructing its state.","id":716,"techniques":["lfsr","custom-cipher"]},{"challenge_name":"Shared Secrets","difficulty":"easy","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"A cryptography challenge testing your knowledge of key exchange protocols and elliptic curve math.","id":715,"techniques":["diffie-hellman","modular-arithmetic"]},{"challenge_name":"Related Messages","difficulty":"medium","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"Two RSA ciphertexts share a key and carry closely related plaintexts. Can you exploit the relationship to recover the flag?","id":713,"techniques":["rsa","franklin-reiter"]},{"challenge_name":"Password Profiler","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"Use personal details and open-source intelligence to crack a hashed password and retrieve the flag.","id":712,"techniques":["password-cracking","wordlist-generation"]},{"challenge_name":"Not TRUe","difficulty":"medium","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"A custom cryptosystem built on lattice mathematics. Analyze the public parameters to break the scheme and decrypt the flag.","id":711,"techniques":["lattice","custom-cipher"]},{"challenge_name":"MultiCode","difficulty":"easy","category":"General Skills","event":"picoCTF 2026","solved":true,"blurb":"A flag buried under many layers of classic encoding schemes. Peel them back one by one to reach the plaintext.","id":710,"techniques":["encoding"]},{"challenge_name":"MSS_ADVANCE Revenge","difficulty":"hard","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"A secret-sharing scheme with fewer shares than unknowns. Advanced cryptanalysis can still recover the secret and the flag.","id":709,"techniques":["secret-sharing","lattice"]},{"challenge_name":"cryptomaze","difficulty":"medium","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"Decrypt a flag protected by a layered encryption scheme combining stream-cipher key generation with a block cipher.","id":703,"techniques":["lfsr","aes"]},{"challenge_name":"ClusterRSA","difficulty":"medium","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"The modulus is multi-prime, so factor out every prime, build phi from all of them, and decrypt as usual.","id":702,"techniques":["rsa","factoring"]},{"challenge_name":"Black Cobra Pepper","difficulty":"medium","category":"Cryptography","event":"picoCTF 2026","solved":true,"blurb":"Reverse engineer a custom block cipher to decrypt the flag. Understanding the cipher\'s structure is the key.","id":701,"techniques":["custom-cipher","block-cipher-analysis"]},{"challenge_name":"Binary Instrumentation 4","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"Frida reveals a hardcoded target, so hook connect() to redirect it at your listener and force the key check to pass.","id":700,"techniques":["frida"]},{"challenge_name":"Binary Instrumentation 3","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"A packed Windows executable unpacks its payload at runtime, so use dynamic instrumentation to intercept the unpacked code.","id":699,"techniques":["frida"]},{"challenge_name":"The Add/On Trap","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2026","solved":true,"blurb":"Dig into a browser extension\'s source to find a flag concealed through obfuscation and encoding tricks.","id":697,"techniques":["source-inspection","encoding","javascript-deobfuscation"]},{"challenge_name":"Timeline 1","difficulty":"medium","category":"Forensics","event":"picoCTF 2026","solved":true,"blurb":"Examine a disk image for signs of timestamp manipulation, then recover the hidden data from the suspicious file.","id":531,"techniques":["disk-forensics","sleuthkit","base64"]},{"challenge_name":"Timeline 0","difficulty":"medium","category":"Forensics","event":"picoCTF 2026","solved":true,"blurb":"Build a filesystem timeline, find the file with an anomalous 1985 timestamp, then icat and Base64-decode it.","id":532,"techniques":["disk-forensics","sleuthkit","base64"]},{"challenge_name":"Rogue Tower","difficulty":"medium","category":"Forensics","event":"picoCTF 2026","solved":true,"blurb":"Analyze captured network traffic to identify a rogue cell tower and recover data that was secretly exfiltrated.","id":533,"techniques":["pcap-analysis","network-forensics"]},{"challenge_name":"Forensics Git 2","difficulty":"medium","category":"Forensics","event":"picoCTF 2026","solved":true,"blurb":"Recover a flag from a disk image containing a git repository where evidence has been deliberately deleted or hidden.","id":534,"techniques":["git","disk-forensics"]},{"challenge_name":"Forensics Git 1","difficulty":"medium","category":"Forensics","event":"picoCTF 2026","solved":true,"blurb":"A disk image holds a git repository with the flag stashed somewhere in its history, including its dangling objects.","id":535,"techniques":["git","disk-forensics"]},{"challenge_name":"Forensics Git 0","difficulty":"medium","category":"Forensics","event":"picoCTF 2026","solved":true,"blurb":"Mount a disk image and comb through a git repository\'s full history and hidden object store to find the flag.","id":536,"techniques":["git","disk-forensics"]},{"challenge_name":"DISKO 4","difficulty":"medium","category":"Forensics","event":"picoCTF 2026","solved":true,"blurb":"Recover a deleted file from a disk image using filesystem forensics tools to retrieve its contents.","id":537,"techniques":["disk-forensics"]},{"challenge_name":"Binary Digits","difficulty":"easy","category":"Forensics","event":"picoCTF 2026","solved":true,"blurb":"A binary file contains a flag encoded in a simple numeric format. Decode it to reveal the plaintext.","id":538,"techniques":["encoding"]},{"challenge_name":"Riddle Registry","difficulty":"easy","category":"Forensics","event":"picoMini by CMU-Africa","solved":true,"blurb":"The flag hides in a PDF\'s metadata: dump every field with exiftool, then decode the Base64 value one of them carries.","id":530,"techniques":["pdf-forensics","metadata-analysis","base64"]},{"challenge_name":"Log Hunt","difficulty":"easy","category":"General Skills","event":"picoMini by CMU-Africa","solved":true,"blurb":"Sift through system log files to trace suspicious activity and find the flag buried in the entries.","id":527,"techniques":["log-analysis","linux-cli"]},{"challenge_name":"Hidden in plainsight","difficulty":"easy","category":"Forensics","event":"picoMini by CMU-Africa","solved":true,"blurb":"exiftool exposes a comment that Base64-decodes twice into a steghide passphrase, which then extracts the hidden file from the JPEG.","id":524,"techniques":["steganography"],"tools":["password-steg"]},{"challenge_name":"Flag in Flame","difficulty":"easy","category":"Forensics","event":"picoMini by CMU-Africa","solved":true,"blurb":"A log file carries a Base64-encoded image, so pull the block out, decode it back to a picture, and read the flag drawn inside it.","id":523,"techniques":["steganography"]},{"challenge_name":"Crack the Gate 1","difficulty":"easy","category":"Web Exploitation","event":"picoMini by CMU-Africa","solved":true,"blurb":"The HTML source hides an encoded comment naming a header that bypasses the login, so decode and send it.","id":520,"techniques":["source-inspection","authentication-bypass"]},{"challenge_name":"Corrupted file","difficulty":"easy","category":"Forensics","event":"picoMini by CMU-Africa","solved":true,"blurb":"The JPEG\'s magic bytes are wrong, so restore the header signature in a hex editor and the image opens.","id":519,"tools":["file-magic-identifier"],"techniques":["file-carving","hex-analysis"]},{"challenge_name":"Pico Bank","difficulty":"medium","category":"Reverse Engineering","event":"picoMini by CMU-Africa","solved":true,"blurb":"Reverse engineer a banking application to bypass its authentication and extract the flag.","id":529,"techniques":["java-reversing","decompilation"]},{"challenge_name":"M1n10n\'5_53cr37","difficulty":"medium","category":"Reverse Engineering","event":"picoMini by CMU-Africa","solved":true,"blurb":"A reverse engineering challenge featuring heavily obfuscated code. Decode the scrambled logic to find the hidden secret.","id":528,"techniques":["decompilation","binary-analysis"]},{"challenge_name":"Input Injection 2","difficulty":"medium","category":"Binary Exploitation","event":"picoMini by CMU-Africa","solved":true,"blurb":"A binary exploitation challenge with input filtering in place. Find a way past the defenses to redirect program execution.","id":526,"techniques":["buffer-overflow"]},{"challenge_name":"Input Injection 1","difficulty":"medium","category":"Binary Exploitation","event":"picoMini by CMU-Africa","solved":true,"blurb":"A binary service takes user input without proper sanitization. Exploit this flaw to hijack execution and read the flag.","id":525,"techniques":["buffer-overflow"]},{"challenge_name":"Crack the Power","difficulty":"medium","category":"Cryptography","event":"picoMini by CMU-Africa","solved":true,"blurb":"The exponent is tiny and the message short, so no modular reduction happened and the plaintext is the integer e-th root.","id":522,"techniques":["rsa"]},{"challenge_name":"Crack the Gate 2","difficulty":"medium","category":"Web Exploitation","event":"picoMini by CMU-Africa","solved":true,"blurb":"The login rate-limits per IP, so brute-force the wordlist while rotating a forwarded-for header on every attempt.","id":521,"techniques":["brute-force","http-headers"]},{"challenge_name":"byp4ss3d","difficulty":"medium","category":"Web Exploitation","event":"picoMini by CMU-Africa","solved":true,"blurb":"A web application hides content behind multiple layers of authentication. Find a way to bypass the controls and retrieve the flag.","id":518,"techniques":["file-upload","filter-bypass"]},{"challenge_name":"SSTI1","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"A web challenge testing a common server-side vulnerability that lets attackers influence how the app renders dynamic content.","id":492,"techniques":["ssti"],"prerequisites":["picoctf-2022-sql-direct"],"tools":["reverse-shell-generator"]},{"challenge_name":"PIE TIME","difficulty":"easy","category":"Binary Exploitation","event":"picoCTF 2025","solved":true,"blurb":"The binary prints main\'s runtime address, so subtract its static offset for the PIE base and add win()\'s offset.","id":490,"techniques":["pie-bypass"],"prerequisites":["picoctf-2024-heap-0"],"tools":["cyclic-pattern","pwntools-payload"]},{"challenge_name":"n0s4n1ty 1","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"An unrestricted upload accepts a PHP file for command execution, and a passwordless sudo entry gives root.","techniques":["file-upload","command-injection"],"tools":["reverse-shell-generator"]},{"challenge_name":"head-dump","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"The API reference documents a /heapdump endpoint, so download the Java heap dump it serves and search the raw bytes for the flag.","techniques":["endpoint-enumeration","http-headers"],"prerequisites":["picoctf-2022-power-cookie"]},{"challenge_name":"hashcrack","difficulty":"easy","category":"Cryptography","event":"picoCTF 2025","solved":true,"blurb":"Three hashes in MD5, SHA-1 and SHA-256 all fall to a wordlist, so identify each by digest length and crack it.","id":475,"techniques":["hash-cracking","wordlist-generation"],"tools":["hash-identifier"],"prerequisites":["picoctf-2024-interencdec"]},{"challenge_name":"Flag Hunters","difficulty":"easy","category":"Reverse Engineering","event":"picoCTF 2025","solved":true,"blurb":"Reverse engineer a Python program and manipulate its input to expose a hidden code path containing the flag.","id":472,"techniques":["code-injection","source-inspection"],"tools":["strings-extractor"]},{"challenge_name":"FANTASY CTF","difficulty":"easy","category":"General Skills","event":"picoCTF 2025","solved":true,"blurb":"The service runs a scripted agreement flow, so answer its prompts and pick the menu option that accepts.","id":471,"techniques":["encoding","linux-cli"]},{"challenge_name":"EVEN RSA CAN BE BROKEN???","difficulty":"easy","category":"Cryptography","event":"picoCTF 2025","solved":true,"blurb":"The modulus is even, which means 2 is a factor: divide it out, derive the private exponent as usual, and decrypt.","id":470,"techniques":["rsa","factoring"],"tools":["rsa-calculator"],"prerequisites":["picoctf-2024-custom-encryption"]},{"challenge_name":"Cookie Monster Secret Recipe","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"The session cookie is a URL-encoded Base64 blob, so peel off both layers and the flag is sitting in plaintext inside it.","id":469,"techniques":["cookie-manipulation","base64"],"prerequisites":["picoctf-2022-inspect-html","picoctf-2022-includes"],"tools":["flask-session-decoder"]},{"challenge_name":"Rust fixme 3","difficulty":"easy","category":"General Skills","event":"picoCTF 2025","solved":true,"blurb":"Fix a Rust program that fails to compile due to a missing safety annotation required for low-level code.","id":463,"techniques":["debugging","rust"]},{"challenge_name":"Rust fixme 2","difficulty":"easy","category":"General Skills","event":"picoCTF 2025","solved":true,"blurb":"Debug a Rust program with ownership and error-handling issues that prevent it from compiling and revealing the flag.","id":462,"techniques":["debugging","rust"]},{"challenge_name":"Rust fixme 1","difficulty":"easy","category":"General Skills","event":"picoCTF 2025","solved":true,"blurb":"Three syntax errors block compilation: a missing semicolon, a stray return keyword, and a bad println! format string.","id":461,"techniques":["debugging","rust"]},{"challenge_name":"RED","difficulty":"easy","category":"Forensics","event":"picoCTF 2025","solved":true,"blurb":"A zsteg scan of the least significant bit plane turns up a Base64 string, which decodes straight into the flag.","id":460,"techniques":["steganography","lsb-stego"],"prerequisites":["picoctf-2022-packets-primer"]},{"challenge_name":"Ph4nt0m 1ntrud3r","difficulty":"easy","category":"Forensics","event":"picoCTF 2025","solved":true,"blurb":"Analyze a network capture to locate and reassemble data that was quietly exfiltrated across multiple packets.","id":459,"techniques":["pcap-analysis","network-forensics","base64"],"prerequisites":["picoctf-2022-packets-primer"],"tools":["file-magic-identifier","metadata-viewer"]},{"challenge_name":"Pachinko","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"The client posts each attempt, so replay that request in a loop from the console until a response carries the flag.","id":494,"techniques":["brute-force","http-automation"]},{"challenge_name":"PIE TIME 2","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2025","solved":true,"blurb":"A binary exploitation challenge combining memory safety weaknesses to defeat address space randomization and redirect execution.","id":491,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["format-string","pie-bypass","aslr-bypass"]},{"challenge_name":"hash-only-2","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2025","solved":true,"blurb":"Escape the restricted shell, then put a fake md5sum earlier on PATH so the privileged helper cats the flag.","id":489,"techniques":["restricted-shell-escape","path-hijacking"]},{"challenge_name":"SSTI2","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"A web challenge testing your ability to exploit template injection with security filters in place.","id":488,"techniques":["ssti","filter-bypass"],"prerequisites":["picoctf-2025-ssti1"],"tools":["reverse-shell-generator"]},{"challenge_name":"hash-only-1","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2025","solved":true,"blurb":"The helper invokes md5sum by bare name, so drop a fake md5sum earlier on PATH and it runs with the helper\'s elevated privileges.","id":487,"techniques":["path-hijacking","privilege-escalation"]},{"challenge_name":"Echo Valley","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2025","solved":true,"blurb":"Exploit a memory corruption vulnerability in a binary to bypass address randomization and hijack execution.","id":485,"tools":["pwntools-payload"],"techniques":["format-string"]},{"challenge_name":"3v@l","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"A web calculator that unsafely evaluates user input behind a keyword filter. Find a way around the restrictions.","id":484,"tools":["reverse-shell-generator"],"techniques":["command-injection"]},{"challenge_name":"YaraRules0x100","difficulty":"medium","category":"General Skills","event":"picoCTF 2025","solved":true,"blurb":"Analyze a packed malware sample and write a detection rule that correctly identifies it.","id":483,"techniques":["yara","malware-analysis"]},{"challenge_name":"flags are stepic","difficulty":"medium","category":"Forensics","event":"picoCTF 2025","solved":true,"blurb":"The flag sits in a PNG\'s least significant bits, put there by the Stepic library, so use that tool to decode it.","techniques":["steganography","lsb-stego"]},{"challenge_name":"WebSockFish","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"The client reports its own evaluation over a WebSocket, so send a winning score and the server concedes the flag.","techniques":["websocket","source-inspection"]},{"challenge_name":"Quantum Scrambler","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2025","solved":true,"blurb":"Reverse engineer a Python script that scrambles data and recover the original flag from its output.","id":479,"techniques":["python-reversing","decompilation"]},{"challenge_name":"Guess My Cheese (Part 2)","difficulty":"medium","category":"Cryptography","event":"picoCTF 2025","solved":true,"blurb":"The service salts and hashes each cheese name, so brute-force the wordlist against every salt until a digest matches.","id":474,"techniques":["hash-cracking","brute-force"]},{"challenge_name":"Guess My Cheese (Part 1)","difficulty":"medium","category":"Cryptography","event":"picoCTF 2025","solved":true,"blurb":"Query an oracle to gather information and deduce the secret value within the allowed number of attempts.","id":473,"techniques":["custom-cipher","classical-cipher"],"tools":["affine-cipher"]},{"challenge_name":"Chronohack","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2025","solved":true,"blurb":"A server generates tokens using a predictable random seed. Reverse engineer the seed to forge a valid token.","id":468,"techniques":["prng","timing-attack","brute-force"]},{"challenge_name":"Apriti sesamo","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"Recover the leaked backup source, then pass arrays so PHP\'s loose comparison accepts the check without a password.","tools":["reverse-shell-generator"],"techniques":["authentication-bypass","type-juggling"]},{"challenge_name":"Tap into Hash","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2025","solved":true,"blurb":"Reverse a custom cipher that combines hashing and XOR operations to recover the encrypted flag.","id":466,"techniques":["xor","custom-cipher"]},{"challenge_name":"perplexed","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2025","solved":true,"blurb":"Analyze a stripped binary, reconstruct its password-encoding logic, and compute the correct input.","id":458,"techniques":["binary-analysis","python-reversing"]},{"challenge_name":"Event-Viewing","difficulty":"medium","category":"Forensics","event":"picoCTF 2025","solved":true,"blurb":"Examine Windows event logs to piece together hidden data spread across multiple recorded events.","id":456,"techniques":["windows-event-logs","log-analysis"]},{"challenge_name":"Bitlocker-2","difficulty":"medium","category":"Forensics","event":"picoCTF 2025","solved":true,"blurb":"A forensics challenge involving a memory dump taken from a system with an encrypted drive mounted.","id":454,"techniques":["memory-forensics","strings"]},{"challenge_name":"Bitlocker-1","difficulty":"medium","category":"Forensics","event":"picoCTF 2025","solved":true,"blurb":"Recover access to an encrypted disk image by breaking the password protecting it.","id":453,"techniques":["disk-forensics","bitlocker"]},{"challenge_name":"Binary Instrumentation 2","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2025","solved":true,"blurb":"Frida hooks correct the path the binary writes to and capture the WriteFile buffer, which turns out to hold the flag as Base64.","id":452,"techniques":["frida"]},{"challenge_name":"Binary Instrumentation 1","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2025","solved":true,"blurb":"Inspect a Windows executable to find a hidden encoded string and recover the flag from it.","id":451,"techniques":["frida"]},{"challenge_name":"secure-email-service","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"A hardened web service with layered defenses. Chain multiple vulnerabilities together to reach the flag.","id":496,"techniques":["header-injection","prng","xss"]},{"challenge_name":"Ricochet","difficulty":"hard","category":"Cryptography","event":"picoCTF 2025","solved":true,"blurb":"The HMAC nonce resets each session, so captured command packets replay with a spoofed controller address to seize the robot.","id":495,"techniques":["replay-attack","nonce-reuse"]},{"challenge_name":"ChaCha Slide","difficulty":"hard","category":"Cryptography","event":"picoCTF 2025","solved":true,"blurb":"The nonce is reused, so XOR the ciphertexts for the keystream, rebuild the Poly1305 key, and forge a valid tag.","id":493,"tools":["aes-decryptor"],"techniques":["stream-cipher"]},{"challenge_name":"handoff","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2025","solved":true,"blurb":"Store shellcode in a recipient entry, then overflow the feedback buffer and pivot execution into it through a jmp rax gadget.","id":486,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow","shellcode","stack-pivot"]},{"challenge_name":"Pachinko Revisited","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2025","solved":true,"blurb":"Dig deeper into a web exhibit\'s source and server artifacts to uncover a second hidden flag.","id":478,"techniques":["wasm","out-of-bounds"]},{"challenge_name":"Verify","difficulty":"easy","category":"Forensics","event":"picoCTF 2024","solved":true,"blurb":"Identify the correct file among many candidates using a checksum, then follow the provided steps to read the flag.","id":450,"techniques":["file-inspection","checksum"]},{"challenge_name":"Scan Surprise","difficulty":"easy","category":"Forensics","event":"picoCTF 2024","solved":true,"blurb":"The flag ships as a QR code rather than text, so locate flag.png and decode it with any QR scanner.","id":444,"techniques":["file-inspection"],"tools":["metadata-viewer","qr-decoder"]},{"challenge_name":"Binary Search","difficulty":"easy","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"Apply a classic computer science algorithm to find a secret number within a limited number of guesses.","id":442,"techniques":["binary-search"],"tools":["binary-search-tree"]},{"challenge_name":"heap 0","difficulty":"easy","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"An introductory heap exploitation challenge exploring how memory management vulnerabilities can be leveraged.","id":438,"techniques":["heap-exploitation","heap-overflow"],"prerequisites":["picoctf-2024-format-string-2"],"tools":["pwntools-payload"]},{"challenge_name":"format string 0","difficulty":"easy","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"A beginner binary exploitation challenge exploring a common vulnerability in C\'s output formatting functions.","id":433,"techniques":["format-string"],"tools":["pwntools-payload"]},{"challenge_name":"WebDecode","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2024","solved":true,"blurb":"The page source carries an attribute holding a Base64 string, so decode that value and the flag comes out in plaintext.","id":427,"techniques":["source-inspection","base64"],"tools":["base64-decoder"]},{"challenge_name":"Unminify","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2024","solved":true,"blurb":"The flag is hidden somewhere in the source of a minified web page. Dig through the code to find it.","id":426,"techniques":["source-inspection","javascript-deobfuscation"]},{"challenge_name":"Time Machine","difficulty":"easy","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"Explore a Git repository\'s history to uncover a flag left behind in an earlier commit.","id":425,"techniques":["git"]},{"challenge_name":"Super SSH","difficulty":"easy","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"Connect to a remote server using a standard protocol and retrieve the flag waiting for you on login.","id":424,"techniques":["ssh","linux-cli"]},{"challenge_name":"Secret of the Polyglot","difficulty":"easy","category":"Forensics","event":"picoCTF 2024","solved":true,"blurb":"A forensics challenge involving a file that is secretly two different formats hiding two halves of the flag.","id":423,"tools":["file-magic-identifier"],"techniques":["file-inspection","steganography"]},{"challenge_name":"IntroToBurp","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2024","solved":true,"blurb":"Intercept the OTP submission in a proxy and rename the otp field, so the server never finds it and skips verification altogether.","id":419,"techniques":["http-headers","burp-suite"]},{"challenge_name":"interencdec","difficulty":"easy","category":"Cryptography","event":"picoCTF 2024","solved":true,"blurb":"enc_flag is Base64 inside Base64 inside a Caesar shift. Decode each layer in order to uncover the flag.","id":418,"techniques":["base64","caesar-cipher"],"tools":["base64-decoder","rot-cipher","cipher-identifier"],"prerequisites":["picoctf-2022-morse-code","picoctf-2022-vigenere"]},{"challenge_name":"endianness","difficulty":"easy","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"A general skills challenge testing your knowledge of how bytes are ordered in computer memory.","id":414,"techniques":["endianness","hex-analysis"],"tools":["number-base-converter"],"prerequisites":["picoctf-2024-binhexa"]},{"challenge_name":"Commitment Issues","difficulty":"easy","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"Recover a flag that was accidentally added and then deleted from a Git repository\'s history.","id":411,"techniques":["git"]},{"challenge_name":"Collaborative Development","difficulty":"easy","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"Piece together a flag spread across multiple branches of a Git repository.","id":410,"techniques":["git"]},{"challenge_name":"CanYouSee","difficulty":"easy","category":"Forensics","event":"picoCTF 2024","solved":true,"blurb":"Run exiftool on ukn_reality.jpg: the Attribution URL field holds a Base64 string that decodes to the flag.","id":408,"techniques":["metadata-analysis","file-inspection"],"tools":["file-magic-identifier","metadata-viewer"]},{"challenge_name":"Bookmarklet","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2024","solved":true,"blurb":"The page hands you bookmarklet JavaScript. Paste it into the browser console instead and it decodes the flag in place.","id":406,"techniques":["source-inspection","javascript"]},{"challenge_name":"Blame Game","difficulty":"easy","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"Use Git history and authorship tools to trace back a breaking change and find the flag.","id":405,"techniques":["git"],"prerequisites":["picoctf-2024-binhexa"]},{"challenge_name":"binhexa","difficulty":"easy","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"Answer a series of prompts testing your knowledge of binary operations and hexadecimal conversion.","id":404,"techniques":["hex-analysis"],"tools":["number-base-converter","binary-calculator"],"prerequisites":["picoctf-2024-super-ssh"]},{"challenge_name":"format string 3","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"A medium-difficulty binary exploitation challenge using a format string vulnerability to manipulate program memory.","id":449,"techniques":["format-string","got-overwrite"],"prerequisites":["picoctf-2024-format-string-2","picoctf-2025-pie-time"],"tools":["pwntools-payload"]},{"challenge_name":"format string 2","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"The format string is user-controlled, so use %n at the right stack offset to write a chosen value into the guard variable.","id":448,"techniques":["format-string","arbitrary-write"],"prerequisites":["picoctf-2024-format-string-1"],"tools":["pwntools-payload"]},{"challenge_name":"Trickster","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2024","solved":true,"blurb":"The upload only checks PNG magic bytes, so prepend them to a PHP shell; the server still runs the file as PHP.","id":445,"techniques":["file-upload"]},{"challenge_name":"No Sql Injection","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2024","solved":true,"blurb":"Operator objects in the login body make the NoSQL query always match, and the reply carries a Base64 token.","id":443,"techniques":["nosql-injection"],"prerequisites":["picoctf-2022-sql-direct"],"tools":["sql-injection"]},{"challenge_name":"heap 3","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"Freeing a chunk before reallocating leaves a dangling pointer, so the next allocation lands there and plants the checked value.","id":440,"techniques":["heap-exploitation","use-after-free"],"prerequisites":["picoctf-2024-heap-2"],"tools":["pwntools-payload"]},{"challenge_name":"heap 1","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"Measure the offset from the input buffer to the adjacent guard variable, then overflow just far enough to overwrite it.","id":439,"techniques":["heap-exploitation","heap-overflow"],"prerequisites":["picoctf-2024-heap-0"],"tools":["pwntools-payload"]},{"challenge_name":"dont-you-love-banners","difficulty":"medium","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"A general skills challenge involving remote service interaction, authentication, and creative use of system features.","id":437,"techniques":["banner-grabbing","symlink-attack"]},{"challenge_name":"SansAlpha","difficulty":"medium","category":"General Skills","event":"picoCTF 2024","solved":true,"blurb":"The shell rejects letters, so build every character you need from error text and globs until you can read the flag file.","id":436,"techniques":["bash"],"prerequisites":["picoctf-2024-blame-game"]},{"challenge_name":"heap 2","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"The overflow reaches a stored function pointer, so overwrite it with the address of win() and let the program call it for you.","id":435,"techniques":["heap-exploitation","heap-overflow"],"prerequisites":["picoctf-2024-heap-1"],"tools":["pwntools-payload"]},{"challenge_name":"format string 1","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"Spray %p across the stack, keep the words that decode to ASCII, and reassemble them in the right order to recover the flag.","id":434,"techniques":["format-string"],"prerequisites":["picoctf-2024-format-string-0"],"tools":["pwntools-payload"]},{"challenge_name":"Blast from the past","difficulty":"medium","category":"Forensics","event":"picoCTF 2024","solved":true,"blurb":"A forensics challenge focused on image metadata. Manipulate timestamps embedded in a photo file to satisfy a validation check.","id":432,"techniques":["metadata-analysis"]},{"challenge_name":"WinAntiDbg0x300","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2024","solved":true,"blurb":"A Windows reverse engineering challenge featuring advanced techniques designed to detect and obstruct debuggers.","id":431,"techniques":["anti-debugging","windows","decompilation"]},{"challenge_name":"WinAntiDbg0x200","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2024","solved":true,"blurb":"Three anti-debugging checks gate the flag, so breakpoint each one and flip the register it tests before execution carries on.","id":430,"techniques":["anti-debugging","windows","decompilation"]},{"challenge_name":"WinAntiDbg0x100","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2024","solved":true,"blurb":"Reverse engineer a Windows binary that uses anti-debugging checks to hide the flag, then work around them.","id":429,"techniques":["anti-debugging","windows","decompilation"]},{"challenge_name":"weirdSnake","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2024","solved":true,"blurb":"Analyze and reverse engineer compiled Python bytecode to recover a hidden flag.","id":428,"techniques":["python-bytecode","python-reversing"],"tools":["strings-extractor"]},{"challenge_name":"rsa_oracle","difficulty":"medium","category":"Cryptography","event":"picoCTF 2024","solved":true,"blurb":"The oracle decrypts anything but the password, so encrypt 2, multiply it into the blocked ciphertext, and halve the result.","id":422,"techniques":["rsa","oracle-attack"],"tools":["rsa-calculator"],"prerequisites":["picoctf-2025-even-rsa-can-be-broken"]},{"challenge_name":"packer","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2024","solved":true,"blurb":"Reverse engineer a binary that has been compressed to conceal its contents and logic.","id":421,"techniques":["unpacking"],"tools":["strings-extractor"]},{"challenge_name":"Mob psycho","difficulty":"medium","category":"Forensics","event":"picoCTF 2024","solved":true,"blurb":"Examine the internals of an Android application package to locate and decode a hidden flag.","id":420,"techniques":["android-reversing","file-carving"],"prerequisites":["picoctf-2022-sleuthkit-intro"],"tools":["file-magic-identifier","strings-extractor"]},{"challenge_name":"FactCheck","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2024","solved":true,"blurb":"Trace the logic of a compiled binary to determine which values satisfy its conditions and form the flag.","id":416,"techniques":["binary-analysis","strings"]},{"challenge_name":"endianness-v2","difficulty":"medium","category":"Forensics","event":"picoCTF 2024","solved":true,"blurb":"A forensics challenge involving a corrupted image file where the byte ordering must be corrected to recover the picture.","id":415,"techniques":["endianness"]},{"challenge_name":"Dear Diary","difficulty":"medium","category":"Forensics","event":"picoCTF 2024","solved":true,"blurb":"Recover deleted or hidden data from a raw disk image using filesystem forensics techniques.","id":413,"techniques":["disk-forensics"]},{"challenge_name":"Custom encryption","difficulty":"medium","category":"Cryptography","event":"picoCTF 2024","solved":true,"blurb":"Reverse engineer a custom multi-step cipher implemented in Python to recover the original plaintext flag.","id":412,"techniques":["custom-cipher","xor"],"tools":["xor-cipher"],"prerequisites":["picoctf-2024-c3"]},{"challenge_name":"Classic Crackme 0x100","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2024","solved":true,"blurb":"Reverse engineer a password-checking program to determine the input that satisfies its hidden validation logic.","id":409,"techniques":["crackme","password-bypass"]},{"challenge_name":"C3","difficulty":"medium","category":"Cryptography","event":"picoCTF 2024","solved":true,"blurb":"Reverse and invert a custom cyclical cipher to recover a flag from encoded output.","id":407,"techniques":["custom-cipher","python-reversing"],"prerequisites":["picoctf-2025-hashcrack"]},{"challenge_name":"elements","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2024","solved":true,"blurb":"Craft the XSS element so it renders in the admin bot\'s page, then exfiltrate around the CSP with an API it misses.","id":447,"techniques":["xss","csp-bypass"]},{"challenge_name":"babygame03","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"Moving out of bounds writes the player tile past the grid, so aim that write at the saved return address.","id":446,"techniques":["out-of-bounds","arbitrary-write"]},{"challenge_name":"high frequency troubles","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2024","solved":true,"blurb":"Chain a House of Orange free primitive with tcache poisoning across the mmap boundary to leak libc and pivot into code execution.","id":441,"techniques":["heap-exploitation","heap-overflow"]},{"challenge_name":"flag_printer","difficulty":"hard","category":"Cryptography","event":"picoCTF 2024","solved":true,"blurb":"The encoding is polynomial interpolation, so recover the coefficients recursively and dump them as a BMP.","id":417,"techniques":["polynomial-arithmetic","modular-arithmetic"]},{"challenge_name":"repetitions","difficulty":"easy","category":"General Skills","event":"picoCTF 2023","solved":true,"blurb":"Decode a flag that has been hidden behind multiple layers of the same encoding scheme.","id":371,"techniques":["base64","python"],"tools":["base64-decoder","cipher-identifier"]},{"challenge_name":"VNE","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2023","solved":true,"blurb":"The privileged binary takes a directory from an unsanitised environment variable, so inject a command and run as root.","id":387,"techniques":["linux-cli","environment-variables"]},{"challenge_name":"Virtual Machine 0","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"The \\"virtual machine\\" is a COLLADA 3D model of a gear train. Count the teeth in Blender and submit the gear ratio.","id":385,"techniques":["3d-model-analysis","file-inspection"]},{"challenge_name":"useless","difficulty":"medium","category":"General Skills","event":"picoCTF 2023","solved":true,"blurb":"Explore a Linux system, interact with a provided utility, and find the documentation that reveals the flag.","id":384,"techniques":["linux-cli","bash"]},{"challenge_name":"two-sum","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2023","solved":true,"blurb":"The check assumes two positive values sum positive, so submitting INT_MAX twice wraps negative and satisfies it.","id":382,"techniques":["integer-overflow"]},{"challenge_name":"timer","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"Reverse engineer an Android app to locate the flag hidden within the compiled application code.","id":381,"techniques":["decompilation","binary-analysis"]},{"challenge_name":"Specialer","difficulty":"medium","category":"General Skills","event":"picoCTF 2023","solved":true,"blurb":"Navigate a restricted SSH environment and use creative shell techniques to read a hidden flag file.","id":378,"techniques":["linux-cli","bash","path-traversal"]},{"challenge_name":"Special","difficulty":"medium","category":"General Skills","event":"picoCTF 2023","solved":true,"blurb":"Break out of a limited shell environment by finding alternative ways to execute commands and read the flag.","id":377,"techniques":["linux-cli","bash"]},{"challenge_name":"SOAP","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2023","solved":true,"blurb":"A web challenge testing a classic XML parsing vulnerability that can expose files on the server.","id":376,"techniques":["xxe"]},{"challenge_name":"Safe Opener 2","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"Analyze a compiled Java class file to recover a flag that was left in the code.","id":375,"techniques":["java-reversing","decompilation"]},{"challenge_name":"rotation","difficulty":"medium","category":"Cryptography","event":"picoCTF 2023","solved":true,"blurb":"Decrypt a flag encoded with a simple letter-shift cipher to recover the plaintext.","id":373,"techniques":["caesar-cipher","custom-cipher"],"tools":["rot-cipher","cipher-identifier"]},{"challenge_name":"Reverse","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"Examine a stripped Linux binary to find a flag string embedded within the compiled code.","id":372,"tools":["strings-extractor"],"techniques":["strings","file-inspection"]},{"challenge_name":"Ready Gladiator 2","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"Compete in a CoreWars-style battle and dominate every round by designing a superior warrior program.","id":370,"techniques":["corewars"]},{"challenge_name":"Ready Gladiator 1","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"Craft a CoreWars warrior that can defeat an Imp opponent at least once across 100 rounds.","id":369,"techniques":["corewars"]},{"challenge_name":"Ready Gladiator 0","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"Write a CoreWars warrior designed to lose every single round against the Imp opponent.","id":368,"techniques":["corewars"]},{"challenge_name":"ReadMyCert","difficulty":"medium","category":"Cryptography","event":"picoCTF 2023","solved":true,"blurb":"Parse an X.509 certificate request file to uncover a flag concealed within its encoded fields.","id":367,"techniques":["encoding","x509"]},{"challenge_name":"Permissions","difficulty":"medium","category":"General Skills","event":"picoCTF 2023","solved":true,"blurb":"sudo grants passwordless vi, and vi can launch a shell from command mode, so use that to spawn a root shell and read the flag.","id":363,"techniques":["linux-cli","permissions","sudo-privilege-escalation"]},{"challenge_name":"PcapPoisoning","difficulty":"medium","category":"Forensics","event":"picoCTF 2023","solved":true,"blurb":"Analyze a packet capture file to find a flag injected into network traffic.","id":362,"techniques":["pcap-analysis"]},{"challenge_name":"MSB","difficulty":"medium","category":"Forensics","event":"picoCTF 2023","solved":true,"blurb":"Recover a flag hidden in the bit-level data of a PNG image using image steganography techniques.","id":359,"techniques":["steganography","msb-stego"]},{"challenge_name":"More SQLi","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2023","solved":true,"blurb":"Bypass the login with an always-true clause, count columns with UNION, read the schema, then select the flag.","id":358,"techniques":["sql-injection","authentication-bypass"],"tools":["sql-injection"]},{"challenge_name":"MatchTheRegex","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2023","solved":true,"blurb":"Inspect a web login form\'s source code to understand the input validation logic and satisfy the check.","id":356,"techniques":["source-inspection","regex"]},{"challenge_name":"Java Code Analysis!?!","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2023","solved":true,"blurb":"Exploit an authentication vulnerability in a Java web API to gain admin-level access and retrieve the flag.","id":355,"techniques":["java-reversing","jwt"]},{"challenge_name":"hijacking","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2023","solved":true,"blurb":"A Linux privilege escalation challenge involving a privileged script with an exploitable code loading flaw.","id":352,"techniques":["linux-cli","sudo-privilege-escalation"]},{"challenge_name":"HideToSee","difficulty":"medium","category":"Cryptography","event":"picoCTF 2023","solved":true,"blurb":"Extract a hidden message from an image file and then decode it using a classic substitution cipher.","id":351,"techniques":["steganography"],"tools":["password-steg","atbash-cipher"]},{"challenge_name":"hideme","difficulty":"medium","category":"Forensics","event":"picoCTF 2023","solved":true,"blurb":"Analyze a PNG image to discover and extract a hidden archive containing the flag.","id":350,"techniques":["steganography","file-carving"],"prerequisites":["picoctf-2025-red"]},{"challenge_name":"findme","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2023","solved":true,"blurb":"Intercept and decode data embedded in a web application\'s HTTP responses to piece together the flag.","id":349,"techniques":["source-inspection","encoding"]},{"challenge_name":"FindAndOpen","difficulty":"medium","category":"Forensics","event":"picoCTF 2023","solved":true,"blurb":"Analyze a packet capture to recover encoded data, then use it to unlock a password-protected archive.","id":348,"techniques":["pcap-analysis","base64","network-forensics"],"tools":["base64-decoder"]},{"challenge_name":"chrono","difficulty":"medium","category":"General Skills","event":"picoCTF 2023","solved":true,"blurb":"Connect to a remote Linux server and explore the filesystem to find a flag hidden in a configuration file.","id":347,"techniques":["linux-cli","permissions"]},{"challenge_name":"babygame01","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2023","solved":true,"blurb":"Walking off the left edge puts the player outside the map array, and the built-in auto-solve then carries you to the exit.","id":345,"techniques":["buffer-overflow"]},{"challenge_name":"Virtual Machine 1","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"Reverse engineer a puzzle that requires understanding mechanical ratios to produce the correct answer for a remote server.","id":386,"techniques":["3d-model-analysis","file-inspection"]},{"challenge_name":"UnforgottenBits","difficulty":"hard","category":"Forensics","event":"picoCTF 2023","solved":true,"blurb":"Dig into a forensic disk image hiding secrets across multiple formats and layers of encoding.","id":383,"techniques":["steganography","disk-forensics"],"tools":["password-steg"]},{"challenge_name":"tic-tac","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2023","solved":true,"blurb":"A binary exploitation challenge testing how file permission checks can be bypassed in a privileged program.","id":380,"techniques":["race-condition"]},{"challenge_name":"SRA","difficulty":"hard","category":"Cryptography","event":"picoCTF 2023","solved":true,"blurb":"A cryptography challenge involving a custom RSA-adjacent scheme that leaks just enough to recover the key.","id":379,"techniques":["rsa"]},{"challenge_name":"PowerAnalysis: Warmup","difficulty":"hard","category":"Cryptography","event":"picoCTF 2023","solved":true,"blurb":"Learn how physical measurements of a running cryptographic algorithm can reveal its secret key.","id":366,"techniques":["side-channel"]},{"challenge_name":"PowerAnalysis: Part 2","difficulty":"hard","category":"Cryptography","event":"picoCTF 2023","solved":true,"blurb":"Average the noisy traces, then run correlation power analysis over all sixteen key bytes; the AES key is the flag.","id":365,"techniques":["side-channel"]},{"challenge_name":"PowerAnalysis: Part 1","difficulty":"hard","category":"Cryptography","event":"picoCTF 2023","solved":true,"blurb":"Use statistical analysis of power traces from an AES implementation to recover secret key bytes.","id":364,"techniques":["side-channel"]},{"challenge_name":"No way out","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2023","solved":true,"blurb":"Escape the bounds of a Unity game to reach a hidden area that contains the flag.","id":361,"techniques":["decompilation","patching"]},{"challenge_name":"msfroggenerator2","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2023","solved":true,"blurb":"A web challenge featuring a content generator with filters you must bypass to execute server-side code.","id":360,"techniques":["xss","filter-bypass"]},{"challenge_name":"Invisible WORDs","difficulty":"hard","category":"Forensics","event":"picoCTF 2023","solved":true,"blurb":"A BMP image hides a ZIP archive across its blue and green colour channels. Extract the channel bytes and unzip the result.","id":354,"techniques":["steganography"]},{"challenge_name":"Horsetrack","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2023","solved":true,"blurb":"The remove path frees a name buffer without clearing the pointer, so poison the tcache and swap free@GOT for system.","id":353,"techniques":["heap-exploitation","use-after-free"]},{"challenge_name":"babygame02","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2023","solved":true,"blurb":"Set the player tile to the low byte of win(), then walk out of bounds until that byte lands on the saved return address.","id":346,"techniques":["out-of-bounds","arbitrary-write"]},{"challenge_name":"cancri-sp","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2023","solved":true,"blurb":"A hard, long-unsolved web exploitation challenge built around a Server-Side Request Forgery in a large custom application.","techniques":["ssrf","path-traversal"]},{"challenge_name":"Local Authority","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"A login page hides its credentials somewhere in the page\'s client-side assets. Explore the source to find them.","id":278,"techniques":["source-inspection","credential-leakage"]},{"challenge_name":"Inspect HTML","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"The flag is tucked inside the page source. A quick look at the HTML is all you need.","id":275,"techniques":["source-inspection"]},{"challenge_name":"Includes","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Parts of the flag are scattered across the site\'s static assets. Inspect the page resources to piece it together.","id":274,"techniques":["source-inspection"]},{"challenge_name":"x-sixty-what","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"A 64-bit binary exploitation challenge testing your ability to corrupt the stack and redirect program execution.","id":319,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow","ret2win"]},{"challenge_name":"Vigenere","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Decrypt a message encoded with a classic polyalphabetic cipher using a provided key.","id":316,"techniques":["vigenere-cipher","classical-cipher"],"tools":["vigenere-cipher"]},{"challenge_name":"unpackme.py","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"The script decrypts and execs its real body, so print that body instead and the source reveals password and flag.","id":314,"techniques":["unpacking","python-reversing"],"prerequisites":["picoctf-2022-bloat-py"]},{"challenge_name":"unpackme","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Reverse engineer a binary that has been compressed and obfuscated to conceal its flag-checking logic.","id":313,"tools":["strings-extractor"],"techniques":["unpacking","decompilation"]},{"challenge_name":"transposition-trial","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Recover a flag from a cipher that rearranges characters in fixed-size blocks.","id":312,"tools":["railfence-cipher"],"techniques":["classical-cipher"]},{"challenge_name":"Torrent Analyze","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Analyze a network packet capture to identify a file downloaded via a peer-to-peer protocol.","id":311,"techniques":["pcap-analysis","network-forensics"]},{"challenge_name":"substitution2","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Break a classical cipher by analyzing letter frequency patterns to recover the plaintext flag.","id":309,"tools":["frequency-analysis"],"techniques":["classical-cipher","frequency-analysis"]},{"challenge_name":"substitution1","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Decode a message scrambled by a letter-substitution cipher using frequency analysis techniques.","id":308,"techniques":["substitution-cipher","frequency-analysis"],"tools":["frequency-analysis"]},{"challenge_name":"substitution0","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Frequency analysis recovers the letter mapping; digits, underscores and braces pass through untouched.","id":307,"tools":["frequency-analysis"],"techniques":["classical-cipher","frequency-analysis"]},{"challenge_name":"St3g0","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"zsteg sweeps every bit plane and channel order at once, and one of those combinations yields the embedded flag.","id":305,"tools":["metadata-viewer"],"techniques":["steganography"]},{"challenge_name":"SQLiLite","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"A web login form with a database vulnerability that can be exploited to bypass authentication.","id":304,"tools":["sql-injection"],"techniques":["sql-injection"]},{"challenge_name":"SQL Direct","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Access a remote database and query it directly to retrieve a protected flag.","id":303,"techniques":["default-credentials","linux-cli"],"prerequisites":["picoctf-2022-roboto-sans"]},{"challenge_name":"Sleuthkit Intro","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Examine a disk image using forensics tools to uncover key partition information.","id":301,"techniques":["disk-forensics","sleuthkit"],"prerequisites":["picoctf-2025-red","picoctf-2023-hideme"]},{"challenge_name":"Sleuthkit Apprentice","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Investigate a disk image to locate a hidden file buried within the filesystem.","id":300,"techniques":["disk-forensics","sleuthkit"],"prerequisites":["picoctf-2022-sleuthkit-intro"]},{"challenge_name":"Secrets","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Follow the nested directories to the deepest page, which renders the flag in white text on a white background.","id":296,"techniques":["path-traversal","endpoint-enumeration"]},{"challenge_name":"Search source","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"The flag is tucked somewhere in a website\'s source code. Find it by exploring the page.","id":295,"techniques":["source-inspection"]},{"challenge_name":"Safe Opener","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Reverse engineer a Java program to extract the password needed to unlock the flag.","id":294,"techniques":["java-reversing","password-bypass"]},{"challenge_name":"RPS","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Beat a remote rock-paper-scissors service by finding an unexpected flaw in its input handling.","id":293,"techniques":["business-logic","source-inspection"]},{"challenge_name":"Roboto Sans","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"robots.txt lists a Disallow entry that is Base64 rather than a path, so decode it and request the file it actually names.","id":291,"techniques":["robots-txt","endpoint-enumeration"],"prerequisites":["picoctf-2025-head-dump"]},{"challenge_name":"Redaction gone wrong","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"A PDF document has text redacted visually, but the underlying data may still be accessible.","id":290,"techniques":["pdf-forensics","file-inspection"]},{"challenge_name":"rail-fence","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Decode a message encrypted with a classical transposition cipher to reveal the flag.","id":289,"techniques":["transposition-cipher","classical-cipher"],"tools":["railfence-cipher"]},{"challenge_name":"Power Cookie","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"The page decides admin status from a single cookie value, so flip it from guest to admin and reload.","id":288,"techniques":["cookie-manipulation"],"prerequisites":["picoctf-2025-cookie-monster-secret-recipe"],"tools":["flask-session-decoder"]},{"challenge_name":"patchme.py","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Analyze a Python script to find the credentials needed to decrypt a protected flag file.","id":287,"techniques":["python-reversing","patching"]},{"challenge_name":"Packets Primer","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Analyze a packet capture file to locate the flag hidden inside captured network traffic.","id":286,"techniques":["pcap-analysis"],"prerequisites":["picoctf-2024-canyousee","picoctf-2024-verify"]},{"challenge_name":"Operation Orchid","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Investigate a disk image to recover credentials and use them to decrypt an encrypted flag file.","id":285,"techniques":["disk-forensics"]},{"challenge_name":"Operation Oni","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Extract authentication material from a disk image to gain remote access and retrieve the flag.","id":284,"techniques":["disk-forensics"]},{"challenge_name":"morse-code","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Decode an audio file encoding a message in a classic dot-and-dash signal format.","id":280,"techniques":["morse-code","classical-cipher"],"tools":["morse-decoder","cipher-identifier"]},{"challenge_name":"Lookey here","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Sift through a large text file to locate the flag hidden somewhere in its contents.","id":279,"tools":["strings-extractor"],"techniques":["strings"]},{"challenge_name":"GDB Test Drive","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Use a debugger to inspect a binary at runtime and manipulate execution to reveal the flag.","id":273,"techniques":["gdb","debugging"],"prerequisites":["picogym-exclusive-bit-o-asm-1"]},{"challenge_name":"Fresh Java","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Decompile a Java class file and analyze its logic to recover the hidden flag.","id":271,"techniques":["java-reversing","decompilation"]},{"challenge_name":"Forbidden Paths","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Input is joined onto a base directory without normalising, so climb out with enough parent references to reach the flag.","id":270,"techniques":["path-traversal"]},{"challenge_name":"flag leak","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Exploit a classic binary vulnerability where user input is passed unsafely to a print function.","id":269,"techniques":["format-string"]},{"challenge_name":"File types","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"The file is wrapped in several archive layers under a misleading name, so peel each by magic bytes, then decode the hex.","id":268,"tools":["file-magic-identifier"],"techniques":["file-inspection","file-magic"]},{"challenge_name":"file-run2","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Run a provided Linux binary and figure out the right input it needs to print the flag.","id":267,"techniques":["binary-execution","linux-cli"]},{"challenge_name":"file-run1","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Run a downloaded binary on Linux to retrieve the flag.","id":266,"techniques":["binary-execution","strings"],"tools":["strings-extractor"]},{"challenge_name":"Enhance!","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Examine an SVG image file to uncover a flag hidden in plain sight.","id":265,"techniques":["image-analysis","hex-analysis"]},{"challenge_name":"Eavesdrop","difficulty":"medium","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Analyze a network packet capture to reconstruct a file transfer and recover the flag.","id":264,"techniques":["pcap-analysis"],"prerequisites":["picoctf-2024-canyousee","picoctf-2024-verify"]},{"challenge_name":"CVE-XXXX-XXXX","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Identify the CVE for the first Windows Print Spooler remote code execution vulnerability of 2021.","id":262,"techniques":["cve","osint"]},{"challenge_name":"credstuff","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Search a leaked credential database and decode an obfuscated password to find the flag.","id":261,"techniques":["credential-leakage","caesar-cipher"],"tools":["rot-cipher","cipher-identifier"]},{"challenge_name":"buffer overflow 2","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Overflow to call win(), and since the binary is 32-bit, place its two magic arguments in a fake call frame behind the address.","id":259,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow"]},{"challenge_name":"buffer overflow 1","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Find the offset with a cyclic pattern, look up the address of win(), and overwrite the saved return address with it.","id":258,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow"]},{"challenge_name":"buffer overflow 0","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Overflow a small buffer in a 32-bit binary to trigger an alternate code path that reveals the flag.","id":257,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow"]},{"challenge_name":"bloat.py","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Reverse engineer an obfuscated Python script to uncover the secret passphrase it accepts.","id":256,"techniques":["python-reversing"],"prerequisites":["picogym-exclusive-gdb-baby-step-1"]},{"challenge_name":"Bbbbloat","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Reverse engineer a bloated binary to discover the single magic value that unlocks the flag.","id":255,"tools":["strings-extractor"],"techniques":["decompilation","binary-analysis"]},{"challenge_name":"basic-mod2","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Decode a sequence of numbers using modular arithmetic and a custom character mapping.","id":254,"tools":["cipher-identifier"],"techniques":["encoding","modular-arithmetic"]},{"challenge_name":"basic-mod1","difficulty":"medium","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Decode a sequence of integers using modular arithmetic and a custom alphabet to recover the flag.","id":253,"tools":["cipher-identifier"],"techniques":["encoding","modular-arithmetic"]},{"challenge_name":"basic-file-exploit","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Exploit an unchecked edge case in a simple file-storage program to leak the flag.","id":252,"techniques":["business-logic","source-inspection"]},{"challenge_name":"Wizardlike","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Reverse engineer a dungeon-crawler binary and bypass its movement restrictions to reach the hidden flag.","id":318,"techniques":["decompilation"]},{"challenge_name":"wine","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Exploit a memory corruption vulnerability in a Windows executable to redirect execution and read the flag.","id":317,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["binary-analysis","decompilation"]},{"challenge_name":"Very Smooth","difficulty":"hard","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Break an RSA key by exploiting a mathematical weakness in how the prime factors were generated.","id":315,"techniques":["rsa"]},{"challenge_name":"Sum-O-Primes","difficulty":"hard","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Factor an RSA modulus using an algebraic relationship between the two primes to decrypt the flag.","id":310,"techniques":["rsa"]},{"challenge_name":"stack cache","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"win() leaves the flag in a stack buffer that is never cleared, so chain it with UnderConstruction() and read the hex.","id":306,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow","rop"]},{"challenge_name":"solfire","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Exploit vulnerabilities in a Solana smart contract to manipulate token balances and capture the flag.","id":302,"techniques":["blockchain","out-of-bounds"]},{"challenge_name":"SideChannel","difficulty":"hard","category":"Forensics","event":"picoCTF 2022","solved":true,"blurb":"Exploit a measurable behavioral difference in a PIN checker to recover an 8-digit secret without brute force.","id":298,"techniques":["side-channel"]},{"challenge_name":"Sequences","difficulty":"hard","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Compute a large mathematical sequence efficiently to produce the value needed for the flag.","id":297,"techniques":["python-reversing","dynamic-programming"]},{"challenge_name":"ropfu","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"A binary exploitation challenge with no win function, requiring you to build an execution chain from scratch.","id":292,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["rop","shellcode"]},{"challenge_name":"NSA Backdoor","difficulty":"hard","category":"Cryptography","event":"picoCTF 2022","solved":true,"blurb":"Break an RSA key by exploiting a backdoored random number generator used during key generation.","id":283,"techniques":["discrete-logarithm","factoring"]},{"challenge_name":"noted","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Cookies are out of reach, so use a login CSRF to move the admin bot into your own account and read its flag note across windows.","id":282,"techniques":["xss"]},{"challenge_name":"Live Art","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2022","solved":true,"blurb":"Exploit a vulnerability in a collaborative web app to trick the admin bot into leaking the flag.","id":277,"techniques":["csrf","xss","race-condition"]},{"challenge_name":"Keygenme","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2022","solved":true,"blurb":"Reverse engineer a binary that validates license keys using a complex algorithmic constraint.","id":276,"techniques":["crackme","keygen"]},{"challenge_name":"function overwrite","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"An out-of-bounds write repoints the scoring function at the easy checker, so any story then scores high enough.","id":272,"techniques":["out-of-bounds","arbitrary-write"]},{"challenge_name":"buffer overflow 3","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2022","solved":true,"blurb":"The canary is re-read each attempt, so brute-force it one byte at a time by watching which guesses avoid a crash.","id":260,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow","stack-canary-bypass"]},{"challenge_name":"DISKO 1","difficulty":"easy","category":"Forensics","event":"picoGym Exclusive","solved":true,"blurb":"Examine a disk image to uncover hidden artifacts and recover the flag through forensic analysis.","id":505,"techniques":["disk-forensics"]},{"challenge_name":"Big Zip","difficulty":"easy","category":"General Skills","event":"picoGym Exclusive","solved":true,"blurb":"Search through a large archive of files to locate the one that contains the flag.","id":322,"techniques":["file-inspection","grep"]},{"challenge_name":"First Find","difficulty":"easy","category":"General Skills","event":"picoGym Exclusive","solved":true,"blurb":"Navigate a ZIP archive, including hidden directories, to find a specific secret file.","id":320,"techniques":["linux-cli","grep"]},{"challenge_name":"DISKO 3","difficulty":"medium","category":"Forensics","event":"picoGym Exclusive","solved":true,"blurb":"strings alone finds nothing, so mount the image, walk the filesystem to the buried archive, and decompress it to read the flag.","id":507,"techniques":["disk-forensics"]},{"challenge_name":"DISKO 2","difficulty":"medium","category":"Forensics","event":"picoGym Exclusive","solved":true,"blurb":"Dig into a second disk image and apply forensic techniques to uncover additional hidden artifacts.","id":506,"techniques":["disk-forensics"]},{"challenge_name":"Picker IV","difficulty":"medium","category":"Binary Exploitation","event":"picoGym Exclusive","solved":true,"blurb":"The service calls whatever address you supply, so resolve the address of win() in the binary and hand that value over.","id":403,"techniques":["binary-analysis","ret2win"]},{"challenge_name":"Picker III","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Reverse engineer a Python script and manipulate its runtime behavior to call the right function.","id":402,"techniques":["python-reversing"]},{"challenge_name":"Picker II","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Analyze a Python script and find a way to bypass its restrictions to access the hidden flag.","id":401,"techniques":["python-reversing"]},{"challenge_name":"Picker I","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Interact with a Python script and figure out how to invoke the function that prints the flag.","id":400,"techniques":["python-reversing"]},{"challenge_name":"Local Target","difficulty":"medium","category":"Binary Exploitation","event":"picoGym Exclusive","solved":true,"blurb":"A binary exploitation challenge involving memory corruption to alter a neighboring variable\'s value.","id":399,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow"]},{"challenge_name":"GDB baby step 4","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Use a debugger to trace a binary\'s execution and identify a key arithmetic value tied to the flag.","id":398,"techniques":["gdb","register-tracing"]},{"challenge_name":"GDB baby step 3","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Use a debugger to inspect memory at runtime and read out the bytes that form the flag.","id":397,"techniques":["gdb","register-tracing"]},{"challenge_name":"GDB baby step 2","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Use a debugger to pause execution and read a register\'s final value to recover the flag.","id":396,"techniques":["gdb","debugging"],"prerequisites":["picogym-exclusive-gdb-baby-step-1"]},{"challenge_name":"GDB baby step 1","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"A beginner-friendly reverse engineering challenge using a debugger to inspect a register value at runtime.","id":395,"techniques":["gdb","debugging","register-tracing"],"prerequisites":["picoctf-2022-gdb-test-drive"]},{"challenge_name":"Bit-O-Asm-4","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Trace a short x86 assembly snippet and compute the final register value to get the flag.","id":394,"techniques":["x86-assembly"]},{"challenge_name":"Bit-O-Asm-3","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Work through a small assembly routine step by step and compute the result to find the flag.","id":393,"techniques":["x86-assembly"],"prerequisites":["picogym-exclusive-bit-o-asm-2"]},{"challenge_name":"Bit-O-Asm-2","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Read a brief x86 assembly listing and trace memory references to determine the flag value.","id":392,"techniques":["x86-assembly","register-tracing"],"prerequisites":["picogym-exclusive-bit-o-asm-1"]},{"challenge_name":"Bit-O-Asm-1","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Interpret a tiny x86 assembly snippet to identify the value loaded into a register.","id":391,"techniques":["x86-assembly","register-tracing"],"prerequisites":["picoctf-2022-file-run1"]},{"challenge_name":"ASCII Numbers","difficulty":"medium","category":"General Skills","event":"picoGym Exclusive","solved":true,"blurb":"Decode a sequence of numeric values into their character equivalents to reveal the hidden flag.","id":390,"techniques":["encoding"]},{"challenge_name":"ASCII FTW","difficulty":"medium","category":"Reverse Engineering","event":"picoGym Exclusive","solved":true,"blurb":"Analyze a disassembled binary and convert raw byte values into readable characters to find the flag.","id":389,"techniques":["x86-assembly","encoding"]},{"challenge_name":"WPA-ing Out","difficulty":"medium","category":"Forensics","event":"picoGym Exclusive","solved":true,"blurb":"Analyze a wireless network packet capture and recover the Wi-Fi passphrase hidden within it.","id":237,"techniques":["wifi-cracking","hash-cracking"]},{"challenge_name":"JAuth","difficulty":"medium","category":"Web Exploitation","event":"picoGym Exclusive","solved":true,"blurb":"Exploit a web authentication vulnerability involving improperly validated tokens to gain admin access.","id":236,"techniques":["jwt"]},{"challenge_name":"Obedient Cat","difficulty":"easy","category":"General Skills","event":"picoCTF 2021","solved":true,"blurb":"A beginner challenge testing basic file retrieval and reading on the command line.","id":768,"techniques":["file-inspection"]},{"challenge_name":"Python Wrangling","difficulty":"medium","category":"General Skills","event":"picoCTF 2021","solved":true,"blurb":"Use a provided Python script and password to decrypt a secret message.","id":769,"techniques":["python","encoding"]},{"challenge_name":"Wave a Flag","difficulty":"easy","category":"General Skills","event":"picoCTF 2021","solved":true,"blurb":"Run a provided binary and explore its command-line options to uncover the flag.","id":770,"techniques":["binary-execution","linux-cli"]},{"challenge_name":"Nice netcat...","difficulty":"easy","category":"General Skills","event":"picoCTF 2021","solved":true,"blurb":"Connect to a server that sends the flag in an encoded format requiring a simple conversion.","id":771,"techniques":["netcat","encoding"]},{"challenge_name":"Static ain\'t always noise","difficulty":"easy","category":"General Skills","event":"picoCTF 2021","solved":true,"blurb":"Inspect a binary file to find human-readable strings hidden inside it.","id":772,"techniques":["strings","file-inspection"]},{"challenge_name":"Tab, Tab, Attack","difficulty":"easy","category":"General Skills","event":"picoCTF 2021","solved":true,"blurb":"Navigate a deeply nested directory structure on Linux to locate and run a hidden binary.","id":773,"techniques":["linux-cli","file-inspection"]},{"challenge_name":"Magikarp Ground Mission","difficulty":"easy","category":"General Skills","event":"picoCTF 2021","solved":true,"blurb":"SSH into a remote instance and piece together a flag split across multiple directories.","id":774,"techniques":["ssh","linux-cli"]},{"challenge_name":"Mod 26","difficulty":"easy","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Decode a message that has been scrambled using a classic letter-substitution cipher.","id":775,"tools":["cipher-identifier"],"techniques":["classical-cipher","caesar-cipher"]},{"challenge_name":"Mind your Ps and Qs","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Exploit a weakness in an RSA key to factor the modulus and recover the encrypted flag.","id":776,"techniques":["rsa"]},{"challenge_name":"Easy Peasy","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"The pad repeats once its key is exhausted, so cycle through the key, capture the segment that encrypted the flag, and XOR it back.","id":777,"techniques":["otp"]},{"challenge_name":"New Caesar","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Reverse a custom cipher built on a Caesar-style shift to recover the original plaintext.","id":778,"techniques":["custom-cipher","caesar-cipher"]},{"challenge_name":"Pixelated","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Recover a hidden image by combining two seemingly random image shares using visual cryptography.","id":779,"techniques":["visual-cryptography","steganography"]},{"challenge_name":"Dachshund Attacks","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Crack an RSA key that was generated with a dangerously small private exponent.","id":780,"techniques":["rsa"]},{"challenge_name":"Mini RSA","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Exploit a misconfigured RSA parameter to recover plaintext without knowing the private key.","id":781,"techniques":["rsa"]},{"challenge_name":"No Padding, No Problem","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Interact with an RSA decryption oracle to recover a message without the private key.","id":782,"techniques":["rsa"]},{"challenge_name":"Play Nice","difficulty":"hard","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Decrypt a message encoded with a classic polygraphic substitution cipher to retrieve the flag.","id":783,"techniques":["custom-cipher"]},{"challenge_name":"Transformation","difficulty":"easy","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Reverse engineer a custom encoding scheme that packs multiple characters into Unicode code points.","id":784,"techniques":["encoding"]},{"challenge_name":"crackme-py","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Read and analyze a Python script to understand its hidden decoding logic and extract the flag.","id":785,"techniques":["python-reversing"]},{"challenge_name":"keygenme-py","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Reverse engineer a Python key-validation routine to derive an input that satisfies the check.","id":786,"techniques":["python-reversing","keygen"]},{"challenge_name":"speeds and feeds","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Decode an unusual data format from a server output to reveal a flag hidden in a toolpath.","id":787,"tools":["strings-extractor"],"techniques":["gcode"]},{"challenge_name":"Shop","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Find an input validation flaw in a simple shop program to gain enough currency to buy the flag.","id":788,"techniques":["python-reversing","business-logic"]},{"challenge_name":"ARMssembly 0","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Read and trace ARM32 assembly by hand to determine the output of a simple comparison function.","id":789,"techniques":["arm-assembly"]},{"challenge_name":"ARMssembly 1","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Analyze ARM32 assembly to manually trace arithmetic operations and determine the resulting value.","id":790,"techniques":["arm-assembly"]},{"challenge_name":"ARMssembly 2","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Simulate an ARM32 loop in your head or with a script to find the final computed value.","id":791,"techniques":["arm-assembly"]},{"challenge_name":"Information","difficulty":"easy","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"Examine an image file\'s hidden metadata to find an encoded value that leads to the flag.","id":792,"tools":["metadata-viewer"],"techniques":["metadata-analysis"]},{"challenge_name":"Matryoshka doll","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"Each image has another file appended inside, so run binwalk and repeat extraction on every nested image.","id":793,"techniques":["steganography","file-carving"]},{"challenge_name":"tunn3l v1s10n","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"A corrupted BMP image hides more than it shows. Analyze the file format to reveal the full picture.","id":794,"tools":["file-magic-identifier"],"techniques":["image-analysis","hex-analysis"]},{"challenge_name":"MacroHard WeakEdge","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"A PowerPoint file conceals a secret. Dig into its internal structure to find the hidden flag.","id":795,"tools":["file-magic-identifier"],"techniques":["zip-forensics","encoding"]},{"challenge_name":"Wireshark doo dooo do doo...","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"Analyze a packet capture to recover a message buried in network traffic, then decode it.","id":796,"techniques":["pcap-analysis"]},{"challenge_name":"Trivial Flag Transfer Protocol","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"A packet capture involving a file-transfer protocol and steganography. Piece together the clues to extract the flag.","id":797,"techniques":["pcap-analysis","steganography"],"tools":["password-steg"]},{"challenge_name":"Disk, disk, sleuth!","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"Investigate a disk image to locate a hidden flag using forensic analysis techniques.","id":798,"techniques":["disk-forensics"]},{"challenge_name":"Disk, disk, sleuth! II","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"Use filesystem forensic tools to navigate a disk image and recover a file from the directory structure.","id":799,"techniques":["disk-forensics"]},{"challenge_name":"GET aHEAD","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A web challenge testing your knowledge of HTTP request methods beyond the standard GET.","id":800,"techniques":["http-headers"]},{"challenge_name":"Cookies","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Explore how a web app uses cookies to identify users, and manipulate them to unlock the flag.","id":801,"tools":["flask-session-decoder"],"techniques":["cookie-manipulation"]},{"challenge_name":"Scavenger Hunt","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Hunt through a website\'s various files and hidden paths to collect all the pieces of the flag.","id":802,"techniques":["source-inspection"]},{"challenge_name":"Some Assembly Required 1","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"The page ships a WebAssembly module, so download it and decompile to WAT, where the expected string sits in the data section.","id":803,"techniques":["wasm","javascript-deobfuscation"]},{"challenge_name":"Who are you?","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"The server checks a whole series of request headers, so set each one it asks for in turn until every condition is satisfied.","id":804,"tools":["flask-session-decoder"],"techniques":["http-headers"]},{"challenge_name":"It is my Birthday","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"The server compares uploads by MD5 alone, so submit a published pair of PDFs that differ in bytes yet share a digest.","id":805,"techniques":["hash-collision"]},{"challenge_name":"Most Cookies","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A web challenge involving a server-side session mechanism that can be tampered with to gain elevated access.","id":806,"tools":["flask-session-decoder"],"techniques":["flask-session"]},{"challenge_name":"Super Serial","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Exploit a PHP web application that improperly handles untrusted serialized data.","id":807,"techniques":["php-deserialization"]},{"challenge_name":"Stonks","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"The menu passes your input straight to printf, so spray specifiers to dump the stack and reassemble the leaked hex.","id":808,"techniques":["format-string"]},{"challenge_name":"Cache Me Outside","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"The heap array index is never bounds-checked, so a negative index reaches back into the freed chunk holding the flag.","id":809,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["tcache","heap-exploitation"]},{"challenge_name":"Unsubscriptions Are Free","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A binary exploitation challenge built around unsafe reuse of freed memory on the heap.","id":810,"techniques":["use-after-free","heap-exploitation"]},{"challenge_name":"2Warm","difficulty":"easy","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"A beginner encoding challenge: convert a number between two common bases to find the flag.","id":811,"techniques":["encoding"]},{"challenge_name":"Lets Warm Up","difficulty":"easy","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"A beginner challenge practicing conversion between hexadecimal values and their ASCII character equivalents.","id":812,"techniques":["encoding"]},{"challenge_name":"Warmed Up","difficulty":"easy","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Practice converting a number from hexadecimal to decimal to form the flag.","id":813,"techniques":["encoding"]},{"challenge_name":"Bases","difficulty":"easy","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Decode a string encoded in a widely used encoding scheme to recover the flag.","id":814,"techniques":["encoding","base64"]},{"challenge_name":"First Grep","difficulty":"easy","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Search through a large text file to find the hidden flag using command-line tools.","id":815,"techniques":["grep","strings"]},{"challenge_name":"strings it","difficulty":"easy","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Extract readable text from a binary file to find the embedded flag.","id":816,"techniques":["strings"]},{"challenge_name":"what\'s a net cat?","difficulty":"easy","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Practice connecting to a remote server using a fundamental command-line networking tool to retrieve the flag.","id":817,"techniques":["netcat"]},{"challenge_name":"plumbing","difficulty":"medium","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"A general skills challenge involving connecting to a remote service and filtering through large amounts of output to find the flag.","id":818,"techniques":["netcat","linux-cli"]},{"challenge_name":"whats-the-difference","difficulty":"medium","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Compare two nearly identical image files to find the differences that spell out the flag.","id":819,"techniques":["file-inspection","hex-analysis"]},{"challenge_name":"where-is-the-file","difficulty":"medium","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"The filename begins with a dot, so an ordinary listing skips it and only ls with the all flag reveals it.","id":820,"techniques":["linux-cli","file-inspection"]},{"challenge_name":"flag_shop","difficulty":"medium","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Buying enough copies overflows the signed total negative, which credits the account instead of charging it.","id":821,"techniques":["integer-overflow"]},{"challenge_name":"mus1c","difficulty":"medium","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Decode a message written in an esoteric programming language that uses song lyrics as code.","id":822,"techniques":["encoding"]},{"challenge_name":"The Numbers","difficulty":"easy","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Decode a message where numbers stand in for letters of the alphabet to reveal the flag.","id":823,"tools":["cipher-identifier"],"techniques":["encoding","classical-cipher"]},{"challenge_name":"13","difficulty":"easy","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Decrypt a message encoded with a classic single-shift letter substitution cipher.","id":824,"tools":["cipher-identifier"],"techniques":["caesar-cipher"]},{"challenge_name":"Easy1","difficulty":"medium","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Decrypt a message encoded with a classic polyalphabetic cipher using a provided key and lookup table.","id":825,"tools":["cipher-identifier"],"techniques":["classical-cipher","otp"]},{"challenge_name":"caesar","difficulty":"medium","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Break a simple classical cipher by trying every possible shift until the plaintext becomes readable.","id":826,"tools":["cipher-identifier"],"techniques":["caesar-cipher"]},{"challenge_name":"la cifra de","difficulty":"medium","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Break a classical polyalphabetic cipher using frequency analysis techniques to recover the hidden message.","id":827,"tools":["cipher-identifier"],"techniques":["classical-cipher","vigenere-cipher"]},{"challenge_name":"Tapping","difficulty":"medium","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Decode a message transmitted as a series of dots and dashes using a well-known encoding standard.","id":828,"tools":["cipher-identifier"],"techniques":["morse-code"]},{"challenge_name":"miniRSA","difficulty":"hard","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Break a weak RSA encryption where a small public exponent makes the ciphertext vulnerable to a mathematical shortcut.","id":829,"techniques":["rsa"]},{"challenge_name":"Glory of the Garden","difficulty":"easy","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Investigate a JPEG image file for data hidden beyond what the image format normally uses.","id":830,"tools":["strings-extractor"],"techniques":["steganography","strings"]},{"challenge_name":"So Meta","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Examine a provided image file\'s metadata to find the flag stored outside the visible image content.","id":831,"tools":["metadata-viewer"],"techniques":["metadata-analysis"]},{"challenge_name":"What Lies Within","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Extract a secret hidden within the pixel data of an image using steganography techniques.","id":832,"tools":["metadata-viewer","strings-extractor"],"techniques":["steganography","lsb-stego"]},{"challenge_name":"extensions","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"A file whose true format is disguised by a misleading extension. Identify what it really is to recover the flag.","id":833,"tools":["file-magic-identifier"],"techniques":["file-inspection","file-magic"]},{"challenge_name":"shark on wire 1","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Analyze a network packet capture to locate a flag hidden within the raw payload of a specific traffic stream.","id":834,"techniques":["pcap-analysis"]},{"challenge_name":"vault-door-training","difficulty":"easy","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Read a Java source file and find the hardcoded secret that unlocks the vault.","id":835,"techniques":["java-reversing","source-inspection"]},{"challenge_name":"vault-door-1","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse engineer a Java program that validates a password one character at a time to reconstruct the correct input.","id":836,"techniques":["java-reversing","crackme"]},{"challenge_name":"vault-door-3","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse a Java program that scrambles a string through index manipulation to recover the original password.","id":837,"techniques":["java-reversing","crackme"]},{"challenge_name":"Insp3ct0r","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Find a flag split across multiple parts of a web page\'s source code, stylesheet, and script files.","id":838,"techniques":["source-inspection"]},{"challenge_name":"where are the robots","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Discover a hidden page on a website by reading a file that tells web crawlers which paths to avoid.","id":839,"techniques":["source-inspection","robots-txt"]},{"challenge_name":"logon","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"The login accepts any credentials and admin status is decided by a cookie the server never verifies, so flip it and reload.","id":840,"techniques":["cookie-manipulation","authentication-bypass"]},{"challenge_name":"Web Gauntlet","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2020 Mini-Competition","solved":true,"blurb":"Five rounds ban ever more SQL keywords, so read /filter.php and rewrite the injection with what is still allowed.","id":841,"tools":["sql-injection"],"techniques":["sql-injection"]},{"challenge_name":"OTP Implementation","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2020 Mini-Competition","solved":true,"blurb":"Reverse engineer a binary that encrypts a flag using a one-time pad, and recover the key to decrypt it.","id":842,"techniques":["otp","xor"]},{"challenge_name":"Guessing Game 1","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2020 Mini-Competition","solved":true,"blurb":"A binary exploitation challenge combining buffer overflow and return-oriented programming to gain code execution.","id":843,"techniques":["buffer-overflow","rop","ret2syscall"]},{"challenge_name":"Guessing Game 2","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2020 Mini-Competition","solved":true,"blurb":"Exploit a binary protected by a stack canary using a two-stage memory leak and buffer overflow attack.","id":844,"techniques":["buffer-overflow","stack-canary-bypass"]},{"challenge_name":"Pitter, Patter, Platters","difficulty":"medium","category":"Forensics","event":"picoCTF 2020 Mini-Competition","solved":true,"blurb":"Examine a disk image for data hidden in unexpected places beyond the normal file system.","id":845,"techniques":["disk-forensics"]},{"challenge_name":"login","difficulty":"medium","category":"Web Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"A web login page where the authentication logic is handled entirely on the client side.","id":846,"techniques":["source-inspection","javascript-deobfuscation"]},{"challenge_name":"caas","difficulty":"medium","category":"Web Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"The URL path is interpolated into a shell command, so add a separator and the rest of your input runs as its own command.","id":847,"tools":["reverse-shell-generator"],"techniques":["command-injection"]},{"challenge_name":"advanced-potion-making","difficulty":"medium","category":"Forensics","event":"picoMini by redpwn","solved":true,"blurb":"A corrupted image file conceals a flag. Repair the file and look closer at its pixel data.","id":848,"techniques":["hex-analysis","file-carving"]},{"challenge_name":"spelling-quiz","difficulty":"medium","category":"Cryptography","event":"picoMini by redpwn","solved":true,"blurb":"Decrypt a classically encrypted message and apply what you learn to recover the flag.","id":849,"techniques":["substitution-cipher","frequency-analysis"]},{"challenge_name":"XtraORdinary","difficulty":"hard","category":"Cryptography","event":"picoMini by redpwn","solved":true,"blurb":"A cryptography challenge built around the properties of repeated XOR operations across multiple inputs.","id":850,"techniques":["xor"]},{"challenge_name":"triple-secure","difficulty":"hard","category":"Cryptography","event":"picoMini by redpwn","solved":true,"blurb":"Three layers of encryption protect the flag, but weak key generation leaves mathematical vulnerabilities to exploit.","id":851,"techniques":["rsa","factoring"]},{"challenge_name":"clutter-overflow","difficulty":"medium","category":"Binary Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"Write past the local array until you reach the neighbouring code variable and set it to the magic value the check expects.","id":852,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow"]},{"challenge_name":"not crypto","difficulty":"hard","category":"Reverse Engineering","event":"picoMini by redpwn","solved":true,"blurb":"Reverse engineer a binary to understand how it validates input and extract the expected flag value.","id":853,"tools":["strings-extractor"],"techniques":["decompilation","encoding"]},{"challenge_name":"scrambled-bytes","difficulty":"hard","category":"Forensics","event":"picoMini by redpwn","solved":true,"blurb":"The first packet carries the seed used to shuffle the payload, so replay that PRNG to undo the permutation and rebuild the PNG.","id":854,"tools":["file-magic-identifier"],"techniques":["encoding","xor"]},{"challenge_name":"notepad","difficulty":"hard","category":"Web Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"A web exploitation challenge involving server-side template injection hidden behind a path traversal vulnerability.","id":855,"techniques":["path-traversal","ssti"]},{"challenge_name":"runme.py","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Run the provided Python script to retrieve the flag -- no modification required.","id":856,"techniques":["python","binary-execution"]},{"challenge_name":"ncme","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Connect to a remote server using a basic network utility to receive the flag.","id":857,"techniques":["netcat"]},{"challenge_name":"convertme.py","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"A beginner Python challenge testing your ability to convert numbers between different bases.","id":858,"techniques":["python","encoding"]},{"challenge_name":"Codebook","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Run a Python script that decodes the flag using a provided codebook lookup table.","id":859,"techniques":["python","encoding"]},{"challenge_name":"fixme1.py","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Find and fix a syntax error in a Python script so it runs correctly and prints the flag.","id":860,"techniques":["python","debugging"]},{"challenge_name":"fixme2.py","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Correct a logic error in a Python script so it evaluates a condition properly and reveals the flag.","id":861,"techniques":["python","debugging"]},{"challenge_name":"PW Crack 1","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Inspect a Python script to find the information needed to pass its password prompt.","id":862,"techniques":["python-reversing","source-inspection"]},{"challenge_name":"Glitch Cat","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Connect to a server that sends the flag in an encoded form you will need to evaluate to read it.","id":863,"techniques":["python","encoding"]},{"challenge_name":"PW Crack 2","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Read a Python script to decode the obfuscated password and unlock the flag.","id":864,"techniques":["python-reversing","encoding","source-inspection"]},{"challenge_name":"HashingJobApp","difficulty":"easy","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Respond to a server\'s hashing challenges quickly and correctly to earn the flag.","id":865,"techniques":["hash-computation","netcat"]},{"challenge_name":"Serpentine","difficulty":"medium","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Read a Python script, spot what is preventing the flag from printing, and fix it.","id":866,"techniques":["python-reversing"]},{"challenge_name":"PW Crack 3","difficulty":"medium","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Crack a hashed password by testing a small set of candidates and use it to unlock the flag.","id":867,"techniques":["python-reversing","hash-cracking"]},{"challenge_name":"PW Crack 4","difficulty":"medium","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Crack a hashed password by testing a set of candidate values. A Python reversing and hash analysis challenge.","id":868,"techniques":["python-reversing","hash-cracking"]},{"challenge_name":"PW Crack 5","difficulty":"medium","category":"General Skills","event":"Beginner picoMini 2022","solved":true,"blurb":"Find the correct password by running a dictionary attack against a hashed credential. A Python and hash cracking challenge.","id":869,"techniques":["python-reversing","hash-cracking"]},{"challenge_name":"dont-use-client-side","difficulty":"easy","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"The password check runs in the browser, so the flag is already in the page source, split into concatenated parts.","id":66,"techniques":["source-inspection","javascript-deobfuscation"]},{"challenge_name":"shark on wire 2","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Analyze a network packet capture to uncover hidden data smuggled inside specific traffic streams.","id":84,"techniques":["pcap-analysis"]},{"challenge_name":"1_wanna_b3_a_r0ck5tar","difficulty":"medium","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Understand and trace a program written in an unconventional esoteric programming language to find the flag.","id":82,"techniques":["esoteric-language"]},{"challenge_name":"like1000","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Extract a flag buried inside a deeply nested series of compressed archives.","id":81,"techniques":["file-inspection","file-carving"]},{"challenge_name":"Irish-Name-Repo 1","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"The username goes straight into the query, so an always-true clause makes the WHERE match and logs you in without a password.","id":80,"tools":["sql-injection"],"techniques":["sql-injection"]},{"challenge_name":"vault-door-5","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse engineer a Java program that hides a password behind multiple layers of encoding transformations.","id":77,"techniques":["java-reversing","encoding"]},{"challenge_name":"vault-door-4","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse a Java program that stores its password check using numeric character representations.","id":71,"techniques":["java-reversing","encoding"]},{"challenge_name":"Client-side-again","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Recover a password hidden inside obfuscated client-side JavaScript running in the browser.","id":69,"techniques":["source-inspection","javascript-deobfuscation"]},{"challenge_name":"Irish-Name-Repo 2","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Bypass a web login form that has partial protections against database query manipulation.","id":59,"tools":["sql-injection"],"techniques":["sql-injection"]},{"challenge_name":"c0rrupt","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Repair a corrupted image file by identifying and fixing structural errors in its raw bytes.","id":53,"tools":["file-magic-identifier"],"techniques":["hex-analysis","file-inspection"]},{"challenge_name":"WhitePages","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Uncover a hidden message encoded using invisible whitespace characters in a text file.","id":51,"techniques":["steganography","encoding"]},{"challenge_name":"vault-door-6","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse a Java program that validates a password using bitwise operations on each character.","id":45,"techniques":["java-reversing","xor"]},{"challenge_name":"Mr-Worldwide","difficulty":"medium","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Decode a message where each piece of data maps to a location, and the locations spell out the flag.","id":40,"techniques":["encoding","classical-cipher"]},{"challenge_name":"waves over lambda","difficulty":"medium","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Crack a classical cipher by analyzing letter patterns and frequencies in the ciphertext.","id":38,"techniques":["classical-cipher","frequency-analysis"]},{"challenge_name":"Based","difficulty":"medium","category":"General Skills","event":"picoCTF 2019","solved":true,"blurb":"Quickly convert values between multiple number bases before the clock runs out to earn the flag.","id":35,"techniques":["encoding"]},{"challenge_name":"Flags","difficulty":"medium","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Decode a message encoded using a visual flag-based alphabet system to recover the hidden text.","id":31,"tools":["cipher-identifier"],"techniques":["encoding"]},{"challenge_name":"m00nwalk","difficulty":"medium","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Extract a hidden image transmitted as an audio signal using a retro analog transmission format.","id":26,"techniques":["audio-stego"]},{"challenge_name":"JaWT Scratchpad","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"A web challenge involving forged authentication tokens to gain unauthorized access as an admin user.","id":25,"techniques":["jwt"]},{"challenge_name":"asm1","difficulty":"medium","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Trace through x86 assembly code by hand to determine what value a function returns for a given input.","id":20,"techniques":["x86-assembly"]},{"challenge_name":"picobrowser","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Access is decided by the User-Agent header alone, so send the browser name the site asks for.","id":9,"techniques":["http-headers"]},{"challenge_name":"Irish-Name-Repo 3","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Bypass a web login that filters common attack inputs by finding alternative ways to manipulate the query.","id":8,"tools":["sql-injection"],"techniques":["sql-injection","authentication-bypass"]},{"challenge_name":"john_pollard","difficulty":"medium","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Factor a very small RSA modulus from a certificate to recover the two prime numbers that make up the key.","id":6,"techniques":["rsa","factoring"]},{"challenge_name":"Investigative Reversing 3","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"The binary hides flag bits in the low bit of eight bytes out of every nine, so find the start offset and invert that cycle.","id":83,"techniques":["steganography","encoding"]},{"challenge_name":"reverse_cipher","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse engineer a binary that implements a custom cipher and recover the original plaintext.","id":79,"tools":["strings-extractor"],"techniques":["x86-assembly","custom-cipher"]},{"challenge_name":"b00tl3gRSA3","difficulty":"hard","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Exploit a flaw in RSA key generation to decrypt a ciphertext and recover the flag.","id":78,"techniques":["rsa"]},{"challenge_name":"AES-ABC","difficulty":"hard","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Break a non-standard AES block cipher mode and decrypt an encoded image to reveal the flag.","id":76,"tools":["aes-decryptor"],"techniques":["aes","custom-cipher"]},{"challenge_name":"zero_to_hero","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2019","solved":true,"blurb":"The banner leaks libc and an off-by-null sets up a double free, so poison the tcache and hijack __free_hook.","id":75,"techniques":["heap-exploitation","use-after-free"]},{"challenge_name":"asm3","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Trace through complex x86 assembly with bitwise operations and stack manipulation to find the return value.","id":72,"techniques":["x86-assembly"]},{"challenge_name":"Investigative Reversing 0","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Reverse a binary that hides flag data inside a PNG image and extract what was embedded.","id":70,"techniques":["steganography","encoding"]},{"challenge_name":"vault-door-7","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse a Java program that encodes a password using bit manipulation to reconstruct the original string.","id":65,"techniques":["java-reversing","encoding"]},{"challenge_name":"droids2","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse engineer an Android APK to find the password that unlocks the flag.","id":63,"techniques":["android-reversing"]},{"challenge_name":"rsa-pop-quiz","difficulty":"hard","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Solve a series of RSA math problems spanning key generation, encryption, and decryption.","id":61,"techniques":["rsa"]},{"challenge_name":"B1ll_Gat35","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse a Java binary with a complex license key check and satisfy all the required conditions.","id":57,"techniques":["windows","decompilation"]},{"challenge_name":"B1g_Mac","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"The flag is written two bytes at a time into the low bits of each copy\'s NTFS timestamp in the ZIP extra fields.","id":56,"techniques":["zip-forensics","metadata-analysis"]},{"challenge_name":"sice_cream","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2019","solved":true,"blurb":"A heap exploitation challenge targeting classic glibc allocator weaknesses to gain code execution.","id":55,"techniques":["heap-exploitation","use-after-free"]},{"challenge_name":"Investigative Reversing 4","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Reverse a steganographic encoder that scatters flag bits across multiple images and reconstruct the flag.","id":54,"techniques":["steganography","encoding"]},{"challenge_name":"seed-sPRiNG","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Predict the output of a pseudo-random number generator to bypass a binary\'s security check.","id":50,"techniques":["prng","binary-analysis"]},{"challenge_name":"investigation_encoded_1","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Reverse a custom encoding binary and write a decoder to recover the hidden flag from its output.","id":47,"techniques":["encoding","binary-analysis"]},{"challenge_name":"WebNet1","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Analyze an encrypted network capture and inspect the transferred files to locate the real flag.","id":42,"techniques":["pcap-analysis","network-forensics"]},{"challenge_name":"Need For Speed","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse engineer a binary with a deliberate timing delay and bypass it to reveal the flag.","id":39,"techniques":["gdb","decompilation"]},{"challenge_name":"investigation_encoded_2","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Reverse a custom variable-length encoding scheme and write a decoder to recover the flag.","id":36,"techniques":["encoding","binary-analysis","brute-force"]},{"challenge_name":"Java Script Kiddie 2","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Analyze a JavaScript image decoder and determine the correct key pair to reconstruct the hidden flag.","id":33,"techniques":["source-inspection","encoding"],"tools":["qr-decoder"]},{"challenge_name":"WebNet0","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Analyze a network packet capture and extract the flag from the captured session data.","id":32,"techniques":["pcap-analysis","network-forensics"]},{"challenge_name":"Java Script Kiddie","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2019","solved":true,"blurb":"Reverse JavaScript that decodes a scrambled image and find the key that restores it correctly.","id":29,"techniques":["source-inspection","encoding"]},{"challenge_name":"m00nwalk2","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Decode a layered audio signal using slow-scan television techniques to uncover the hidden flag.","id":28,"techniques":["audio-stego"],"tools":["password-steg"]},{"challenge_name":"Investigative Reversing 1","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"Analyze binary-modified image files to locate and reconstruct flag bytes hidden in each file.","id":27,"techniques":["steganography","encoding"]},{"challenge_name":"Forky","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Trace program execution through a forked process tree to identify which branch produces the flag.","id":24,"tools":["strings-extractor"],"techniques":["decompilation","x86-assembly"]},{"challenge_name":"droids3","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Modify and repackage an Android APK to unlock a code path that reveals the flag.","id":23,"techniques":["android-reversing","patching"]},{"challenge_name":"droids4","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse a heavily obfuscated Android app with integrity protections and extract the flag from its native code.","id":17,"techniques":["android-reversing","frida"]},{"challenge_name":"asm2","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Trace through x86 assembly with loops and conditionals to determine what value a function returns for given inputs.","id":16,"techniques":["x86-assembly"]},{"challenge_name":"droids1","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse engineer an Android APK to understand how it validates user input and recover the hidden flag.","id":14,"techniques":["android-reversing"]},{"challenge_name":"Investigative Reversing 2","difficulty":"hard","category":"Forensics","event":"picoCTF 2019","solved":true,"blurb":"A forensics challenge combining binary analysis and steganography to recover a flag concealed across image data.","id":13,"techniques":["steganography","encoding"]},{"challenge_name":"droids0","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Explore and decompile an Android APK to locate a flag hidden somewhere in the application.","id":11,"techniques":["android-reversing"]},{"challenge_name":"vault-door-8","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Reverse a Java program that scrambles character data through bitwise operations to protect a flag.","id":10,"techniques":["java-reversing","encoding"]},{"challenge_name":"asm4","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2019","solved":true,"blurb":"Trace recursive x86 assembly functions through multiple stack frames to determine the final computed value.","id":5,"techniques":["x86-assembly"]},{"challenge_name":"b00tl3gRSA2","difficulty":"hard","category":"Cryptography","event":"picoCTF 2019","solved":true,"blurb":"Decrypt RSA ciphertext where a weak choice of public exponent makes the private key recoverable.","id":2,"techniques":["rsa"]},{"challenge_name":"Web Gauntlet 2","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Bypass an SQL injection filter with extended keyword restrictions to authenticate as admin on a web application.","id":174,"tools":["sql-injection"],"techniques":["sql-injection"]},{"challenge_name":"It is my Birthday 2","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"A cryptography challenge exploiting weaknesses in SHA-1 collision resistance to pass a file integrity check.","id":169,"techniques":["hash-collision"]},{"challenge_name":"Binary Gauntlet 0","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"An unbounded strcpy lets you smash the stack, and the pre-registered crash handler prints the flag when the program dies.","id":167,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["buffer-overflow"]},{"challenge_name":"Binary Gauntlet 2","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Combine two different vulnerability classes in a binary to leak memory and achieve arbitrary code execution.","id":143,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["format-string","shellcode"]},{"challenge_name":"Milkslap","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"Investigate a web page image for data hidden within the pixel values using steganographic techniques.","id":139,"techniques":["steganography","lsb-stego"]},{"challenge_name":"What\'s your input?","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A service that processes your input unsafely, letting you run arbitrary code and read the flag remotely.","id":138,"techniques":["python","code-injection"]},{"challenge_name":"Binary Gauntlet 3","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A binary exploitation gauntlet with full mitigations enabled, requiring chained techniques to gain code execution.","id":133,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["rop","format-string"]},{"challenge_name":"Some Assembly Required 2","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Reverse engineer obfuscated WebAssembly in the browser to understand its input validation and extract the flag.","id":131,"techniques":["wasm","javascript-deobfuscation"]},{"challenge_name":"Web Gauntlet 3","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Bypass a strict SQL injection filter with character and keyword restrictions to log in as admin.","id":128,"tools":["sql-injection"],"techniques":["sql-injection"]},{"challenge_name":"Binary Gauntlet 1","difficulty":"medium","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"NX is off and the program prints its own buffer address, so put shellcode there and return to the leak.","id":126,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["shellcode"]},{"challenge_name":"More Cookies","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Manipulate an encrypted session cookie to gain admin access to a web application.","id":124,"tools":["flask-session-decoder"],"techniques":["cookie-manipulation","aes"]},{"challenge_name":"It\'s Not My Fault 2","difficulty":"medium","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"The CRT exponent d_p is 36 bits but not brute-forceable, so build a subproduct tree in Sage to recover it.","id":120,"techniques":["rsa","factoring","polynomial-arithmetic"]},{"challenge_name":"Wireshark twoo twooo two twoo...","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"Sift through a noisy packet capture full of red herrings to identify and extract the real flag data.","id":110,"techniques":["pcap-analysis"]},{"challenge_name":"Startup Company","difficulty":"medium","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Find and exploit a vulnerability in a web application to gain unauthorized access and retrieve the flag.","id":108,"techniques":["sql-injection","filter-bypass"]},{"challenge_name":"Weird File","difficulty":"medium","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"Inspect an unusual file format to uncover hidden content and decode the embedded flag.","id":101,"tools":["file-magic-identifier"],"techniques":["file-inspection","file-magic"]},{"challenge_name":"Bithug","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Chain together multiple web vulnerabilities in a custom Git hosting platform to gain admin access and retrieve the flag.","id":190,"techniques":["ssrf","git"]},{"challenge_name":"X marks the spot","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Exploit an injection vulnerability in a web app\'s query handling to extract server-side data containing the flag.","id":185,"techniques":["xpath-injection"]},{"challenge_name":"filtered-shellcode","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"The loader splices NOP bytes between yours, so build execve from one- and two-byte instructions that survive it.","id":184,"techniques":["shellcode"]},{"challenge_name":"ARMssembly 4","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Trace recursive ARM assembly with complex branching to work out what the program returns for a given input.","id":183,"techniques":["arm-assembly"]},{"challenge_name":"Some Assembly Required 4","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A web challenge embedding program logic inside a WebAssembly module that has been deliberately obscured across multiple layers.","id":182,"techniques":["wasm","javascript-deobfuscation"]},{"challenge_name":"Bizz Fuzz","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A binary exploitation challenge buried deep inside a FizzBuzz-driven call graph. Find the vulnerable function and exploit it.","id":181,"techniques":["buffer-overflow","binary-analysis","ret2win"]},{"challenge_name":"Here\'s a LIBC","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Exploit a binary with memory protections enabled using a supplied libc to craft a working chain that gives you a shell.","id":179,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["rop","ret2libc"]},{"challenge_name":"Turboflan","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A custom-patched JavaScript engine introduces a memory-safety flaw; identify it and leverage it to reach the flag.","id":178,"techniques":["v8-pwn","jit-compiler"]},{"challenge_name":"The Office","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A menu-driven binary with low-level memory vulnerabilities. Navigate the interface to trigger a bug and extract the flag.","id":172,"tools":["cyclic-pattern","pwntools-payload"],"techniques":["heap-overflow","heap-exploitation"]},{"challenge_name":"gogo","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Reverse a compiled Go binary with stripped debug symbols and recover the input validation logic to find the correct flag.","id":171,"techniques":["binary-analysis","gdb"]},{"challenge_name":"Kit Engine","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"Exploit a vulnerability in a custom JavaScript engine implementation to gain unauthorized memory access and retrieve the flag.","id":168,"techniques":["shellcode","v8-pwn"]},{"challenge_name":"Stonk Market","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"The flag is off the stack now, so use %n to write sh into a heap buffer and repoint free@got at system.","id":164,"techniques":["format-string"]},{"challenge_name":"Some Assembly Required 3","difficulty":"hard","category":"Web Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A WebAssembly crackme that encrypts the flag using a key hidden inside the compiled module. Analyze and reverse the cipher.","id":153,"techniques":["wasm","xor"]},{"challenge_name":"Rolling My Own","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Reverse a binary that encrypts data using a hand-rolled algorithm. Understand its logic and invert it to recover the correct input.","id":151,"techniques":["custom-cipher"]},{"challenge_name":"Checkpass","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"A Rust binary checks your password in a way that leaks information, so recover it one character at a time.","id":149,"techniques":["binary-analysis","timing-attack","side-channel"]},{"challenge_name":"New Vignere","difficulty":"hard","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Break a cipher that resembles Vigenere but operates on a non-standard alphabet with modified key scheduling.","id":148,"techniques":["vigenere-cipher","custom-cipher"]},{"challenge_name":"Very very very Hidden","difficulty":"hard","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"A forensics challenge involving a packet capture and an image file with a hidden payload embedded using steganography.","id":141,"techniques":["steganography"]},{"challenge_name":"Double DES","difficulty":"hard","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Attack a double-encryption scheme by exploiting a fundamental weakness in how two cipher passes interact.","id":140,"tools":["aes-decryptor"],"techniques":["block-cipher-analysis","meet-in-the-middle"]},{"challenge_name":"Clouds","difficulty":"hard","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Cryptanalysis challenge based on an obscure block cipher. A chosen-plaintext oracle is available to help you recover the flag.","id":136,"techniques":["custom-cipher","chosen-plaintext-attack"]},{"challenge_name":"Download Horsepower","difficulty":"hard","category":"Binary Exploitation","event":"picoCTF 2021","solved":true,"blurb":"A custom builtin sets a JSArray\'s length unchecked, giving out-of-bounds access, addrof, fakeobj, and an RWX page.","id":135,"techniques":["v8-pwn","heap-exploitation"]},{"challenge_name":"Compress and Attack","difficulty":"hard","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"Your input is compressed with the flag before encryption, so ciphertext length reveals guesses sharing its prefix.","id":127,"techniques":["compression-oracle","aes"]},{"challenge_name":"It\'s Not My Fault 1","difficulty":"hard","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"RSA-CRT here uses a small d_p, so brute-force that exponent, factor the modulus from it, and send back the sum of the two primes.","id":123,"techniques":["rsa","factoring"]},{"challenge_name":"Easy as GDB","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"The binary validates input one character at a time, so use a debugger to watch the comparisons and read the flag out.","id":122,"techniques":["gdb","x86-assembly"]},{"challenge_name":"Powershelly","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Reverse engineer a PowerShell script that processes the flag through multiple encoding or encryption transformations.","id":119,"techniques":["powershell","decompilation"]},{"challenge_name":"Surfing the Waves","difficulty":"hard","category":"Forensics","event":"picoCTF 2021","solved":true,"blurb":"The raw sample values spell a hex string rather than audio, so read them out, decode the hex, and convert the result to ASCII.","id":117,"techniques":["audio-stego"]},{"challenge_name":"Scrambled: RSA","difficulty":"hard","category":"Cryptography","event":"picoCTF 2021","solved":true,"blurb":"The message is split before encryption, so encrypt guesses and compare block multisets to recover the flag character by character.","id":107,"techniques":["rsa"]},{"challenge_name":"ARMssembly 3","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Trace ARM assembly code through loops and bitwise operations to determine the correct output for a given input.","id":106,"techniques":["arm-assembly"]},{"challenge_name":"Let\'s get dynamic","difficulty":"hard","category":"Reverse Engineering","event":"picoCTF 2021","solved":true,"blurb":"Reverse engineer a binary by observing its behavior at runtime rather than analyzing static code.","id":102,"techniques":["debugging","gdb"]},{"challenge_name":"MATRIX","difficulty":"hard","category":"Reverse Engineering","event":"picoMini by redpwn","solved":true,"blurb":"Reverse engineer a binary that runs code through a custom virtual machine with its own instruction set.","id":221,"techniques":["encoding","decompilation"]},{"challenge_name":"breadth","difficulty":"hard","category":"Reverse Engineering","event":"picoMini by redpwn","solved":true,"blurb":"Identify meaningful differences between two versions of a binary to locate the real flag among many decoys.","id":220,"techniques":["decompilation"]},{"challenge_name":"riscy business","difficulty":"hard","category":"Reverse Engineering","event":"picoMini by redpwn","solved":true,"blurb":"Reverse engineer a non-x86 binary implementing a stream cipher to recover the flag.","id":219,"techniques":["risc-v-assembly"]},{"challenge_name":"vr-school","difficulty":"hard","category":"Binary Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"Freeing a student leaves a dangling pointer, so overlap it with a name buffer, leak libc and the stack, then ROP.","id":218,"tools":["pwntools-payload"],"techniques":["use-after-free","heap-exploitation","rop"]},{"challenge_name":"homework","difficulty":"hard","category":"Binary Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"Exploit a memory vulnerability in a heap-based application to gain control and retrieve the flag.","id":217,"tools":["pwntools-payload"],"techniques":["out-of-bounds","esoteric-language"]},{"challenge_name":"fermat-strings","difficulty":"hard","category":"Binary Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"Exploit a classic input-handling vulnerability to read from or write to arbitrary memory.","id":215,"techniques":["format-string"]},{"challenge_name":"lockdown-horses","difficulty":"hard","category":"Binary Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"Exploit a binary running under a restricted syscall policy to retrieve the flag.","id":214,"techniques":["buffer-overflow","rop","stack-pivot","seccomp-bypass"]},{"challenge_name":"SaaS","difficulty":"hard","category":"Binary Exploitation","event":"picoMini by redpwn","solved":true,"blurb":"Craft shellcode for a service that accepts and runs your code under a strict system call filter.","id":213,"techniques":["shellcode","seccomp-bypass"]},{"challenge_name":"college-rowing-team","difficulty":"hard","category":"Cryptography","event":"picoMini by redpwn","solved":true,"blurb":"Break a custom encryption scheme by exploiting algebraic weaknesses in its design.","id":212,"techniques":["rsa","modular-arithmeti